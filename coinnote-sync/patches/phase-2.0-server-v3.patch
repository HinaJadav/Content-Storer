diff --git a/tests/buildGate.test.ts b/tests/buildGate.test.ts
new file mode 100644
index 0000000..9bb7f2d
--- /dev/null
+++ b/tests/buildGate.test.ts
@@ -0,0 +1,87 @@
+import { describe, it, expect } from "vitest";
+import { buildGateService } from "../src/servies/buildGate.service.js";
+
+/**
+ * 2.0 — build gate: what an app build may receive, by its Play Store version code.
+ * Pure logic, no mocks.
+ */
+
+const OLD_ROWS = [
+    { id: 1, query: "CREATE TABLE a(x);", guiversion: "1.0.0" },
+    { id: 2, query: "ALTER TABLE a ADD y;", guiversion: "" },
+];
+const NEW_ROW = { id: 3, query: "CREATE TABLE b(x);", guiversion: "35" };
+const LATER_ROW = { id: 4, query: "CREATE TABLE c(x);", guiversion: "" };
+
+describe("toVersionCode", () => {
+    it("keeps a valid version code", () => {
+        expect(buildGateService.toVersionCode(35)).toBe(35);
+        expect(buildGateService.toVersionCode("35")).toBe(35);
+    });
+
+    it("missing / invalid -> 0 (old build)", () => {
+        for (const bad of [undefined, null, "", "abc", -1, 1.5, Number.NaN]) {
+            expect(buildGateService.toVersionCode(bad)).toBe(0);
+        }
+    });
+});
+
+describe("rowMinVersionCode", () => {
+    it("whole number guiversion is the minimum version code", () => {
+        expect(buildGateService.rowMinVersionCode("35")).toBe(35);
+    });
+
+    it("non-number guiversion -> 0 (every build)", () => {
+        for (const value of ["1.0.0", "", "abc", null, undefined, "0", "-3"]) {
+            expect(buildGateService.rowMinVersionCode(value)).toBe(0);
+        }
+    });
+});
+
+describe("filterMigrations", () => {
+    it("every row allowed -> toVersion = latest", () => {
+        const gate = buildGateService.filterMigrations(OLD_ROWS, 1, 0, 2);
+        expect(gate.allowed.map((r) => r.id)).toEqual([1, 2]);
+        expect(gate.toVersion).toBe(2);
+    });
+
+    it("old build stops at the first row it may not run, later rows held back too", () => {
+        const gate = buildGateService.filterMigrations([...OLD_ROWS, NEW_ROW, LATER_ROW], 34, 0, 4);
+        expect(gate.allowed.map((r) => r.id)).toEqual([1, 2]);
+        expect(gate.toVersion).toBe(2);
+    });
+
+    it("new build gets every row", () => {
+        const gate = buildGateService.filterMigrations([...OLD_ROWS, NEW_ROW, LATER_ROW], 35, 0, 4);
+        expect(gate.allowed.map((r) => r.id)).toEqual([1, 2, 3, 4]);
+        expect(gate.toVersion).toBe(4);
+    });
+
+    it("first pending row held back -> nothing allowed, toVersion = current", () => {
+        const gate = buildGateService.filterMigrations([NEW_ROW], 34, 2, 3);
+        expect(gate.allowed).toEqual([]);
+        expect(gate.toVersion).toBe(2);
+    });
+
+    it("no pending rows -> toVersion = latest (same as before)", () => {
+        const gate = buildGateService.filterMigrations([], 34, 5, 5);
+        expect(gate.allowed).toEqual([]);
+        expect(gate.toVersion).toBe(5);
+    });
+});
+
+describe("isNewSchemaBuild", () => {
+    it("version code at or above the limit -> true", () => {
+        expect(buildGateService.isNewSchemaBuild(35, 35)).toBe(true);
+        expect(buildGateService.isNewSchemaBuild(40, 35)).toBe(true);
+    });
+
+    it("below the limit -> false", () => {
+        expect(buildGateService.isNewSchemaBuild(34, 35)).toBe(false);
+        expect(buildGateService.isNewSchemaBuild(0, 35)).toBe(false);
+    });
+
+    it("no limit configured (null) -> false for every build", () => {
+        expect(buildGateService.isNewSchemaBuild(99, null)).toBe(false);
+    });
+});
diff --git a/tests/dbversion.service.test.ts b/tests/dbversion.service.test.ts
new file mode 100644
index 0000000..9bf3a2a
--- /dev/null
+++ b/tests/dbversion.service.test.ts
@@ -0,0 +1,79 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+/**
+ * 2.0 — dbversion.service uses the build gate (only the new wiring is tested here;
+ * the version rules themselves are in buildGate.test.ts).
+ */
+
+const migrationsAfter = vi.fn();
+const newSchemaLimit = vi.fn();
+
+vi.mock("../src/repositories/dbversion.repository.js", () => ({
+    dbVersionRepository: {
+        findByUserId: async () => ({ id: 7, name: "Asha", email: "a@x.com", mobilenumber: "99", age: 30 }),
+        getLatestVersion: async () => 3,
+        getMigrationsAfter: (v: number) => migrationsAfter(v),
+    },
+}));
+vi.mock("../src/repositories/defaultQuery.repository.js", () => ({
+    defaultQueryRepository: { getAllDefaultQueries: async () => [{ query: DEFAULT_SQL }] },
+}));
+vi.mock("../src/servies/appConfig.service.js", () => ({
+    appConfigService: { getNewSchemaMinVersionCode: () => newSchemaLimit() },
+}));
+vi.mock("../src/utils/signatureGenerator.js", () => ({
+    signPayload: (data: unknown) => ({ data: data }),
+}));
+
+const DEFAULT_SQL = "INSERT INTO category (name) VALUES ('Food');";
+const ROWS = [
+    { id: 1, query: "CREATE TABLE a(x);", guiversion: "1.0.0" },
+    { id: 2, query: "ALTER TABLE a ADD y;", guiversion: "" },
+    { id: 3, query: "CREATE TABLE b(x);", guiversion: "35" },
+];
+
+const { dbVersionService } = await import("../src/servies/dbversion.service.js");
+
+async function check(versionCode: unknown, firstLogin = true) {
+    migrationsAfter.mockResolvedValue(ROWS);
+    const result = await dbVersionService.checkForUpdates(0, "", 7, firstLogin, true, versionCode as number);
+    return result.Data as { script: string[]; toVersion: number };
+}
+
+beforeEach(() => {
+    newSchemaLimit.mockResolvedValue(35);
+});
+
+describe("dbversion.service + build gate", () => {
+    it("old build: held-back row not sent, toVersion and guidbversion = last row sent, defaults sent", async () => {
+        const data = await check(34);
+        expect(data.script).not.toContain("CREATE TABLE b(x);");
+        expect(data.toVersion).toBe(2);
+        expect(data.script).toContain('INSERT INTO guidbversion ("dbId") VALUES (2);');
+        expect(data.script).toContain(DEFAULT_SQL);
+    });
+
+    it("new build: every row, toVersion = latest, no defaults", async () => {
+        const data = await check(35);
+        expect(data.script).toContain("CREATE TABLE b(x);");
+        expect(data.toVersion).toBe(3);
+        expect(data.script).not.toContain(DEFAULT_SQL);
+    });
+
+    it("version code not sent (old app) -> treated as old build", async () => {
+        const data = await check(undefined);
+        expect(data.toVersion).toBe(2);
+        expect(data.script).toContain(DEFAULT_SQL);
+    });
+
+    it("no limit configured -> defaults for every build", async () => {
+        newSchemaLimit.mockResolvedValue(null);
+        const data = await check(35);
+        expect(data.script).toContain(DEFAULT_SQL);
+    });
+
+    it("not first login -> no defaults", async () => {
+        const data = await check(34, false);
+        expect(data.script).not.toContain(DEFAULT_SQL);
+    });
+});
