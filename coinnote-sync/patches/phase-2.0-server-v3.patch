+++ b/src/servies/buildGate.service.ts
@@ -0,0 +1,75 @@
+/**
+ * Build gate
+ * ----------
+ * Decides what an app build may receive, by its Play Store version code.
+ * Pure logic: no DB access, no config reads (callers pass the values in).
+ */
+
+export interface MigrationRow {
+  id: number;
+  query: string;
+  guiversion: string | null;
+}
+
+export const buildGateService = {
+  /**
+   * Version code sent by the app.
+   * Missing / invalid -> 0 (old builds don't send it, they count as old build).
+   */
+  toVersionCode(value: unknown): number {
+    const parsed = Number(value);
+    return Number.isInteger(parsed) && parsed > 0 ? parsed : 0;
+  },
+
+  /**
+   * dbversions.guiversion = minimum version code that may run this row.
+   * Not a whole number (old rows like "1.0.0" or "") -> 0, row goes to every build.
+   */
+  rowMinVersionCode(guiversion: string | null | undefined): number {
+    const parsed = Number(guiversion);
+    return Number.isInteger(parsed) && parsed > 0 ? parsed : 0;
+  },
+
+  /**
+   * Keeps rows in order and stops at the first row this build may not run.
+   * The build reports only up to the last row sent, so after an app update
+   * the held-back rows are sent next time (never skipped).
+   *
+   * @returns allowed rows + toVersion (version the build reaches after running them)
+   */
+  filterMigrations(
+    rows: MigrationRow[],
+    versionCode: number,
+    currentVersion: number,
+    latestVersion: number,
+  ): { allowed: MigrationRow[]; toVersion: number } {
+    const allowed: MigrationRow[] = [];
+    let heldBack = false;
+
+    for (const row of rows) {
+      if (versionCode < buildGateService.rowMinVersionCode(row.guiversion)) {
+        heldBack = true;
+        break;
+      }
+      allowed.push(row);
+    }
+
+    let toVersion = latestVersion;
+    if (heldBack) {
+      toVersion = currentVersion;
+      if (allowed.length > 0) {
+        toVersion = allowed[allowed.length - 1].id;
+      }
+    }
+
+    return { allowed: allowed, toVersion: toVersion };
+  },
+
+  /**
+   * true when this build has the new (UUID) local schema and creates default
+   * categories itself. No limit configured (null) -> false for every build.
+   */
+  isNewSchemaBuild(versionCode: number, newSchemaMinVersionCode: number | null): boolean {
+    return newSchemaMinVersionCode !== null && versionCode >= newSchemaMinVersionCode;
+  },
+};
