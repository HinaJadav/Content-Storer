+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+/**
+ * 2.0 — appConfigService.getNewSchemaMinVersionCode (config key new_schema_min_version_code).
+ * config table is mocked: no database needed.
+ */
+
+const getValue = vi.fn();
+vi.mock("../src/repositories/appConfig.repository.js", () => ({
+    appConfigRepository: { getValue: (key: string) => getValue(key) },
+}));
+
+const { appConfigService } = await import("../src/servies/appConfig.service.js");
+
+beforeEach(() => {
+    getValue.mockReset();
+});
+
+describe("getNewSchemaMinVersionCode", () => {
+    it("reads new_schema_min_version_code", async () => {
+        getValue.mockImplementation(async (key: string) => (key === "new_schema_min_version_code" ? "35" : null));
+        expect(await appConfigService.getNewSchemaMinVersionCode()).toBe(35);
+    });
+
+    it("missing key -> null", async () => {
+        getValue.mockResolvedValue(null);
+        expect(await appConfigService.getNewSchemaMinVersionCode()).toBeNull();
+    });
+
+    it("invalid value -> null", async () => {
+        for (const bad of ["abc", "0", "-5", ""]) {
+            getValue.mockResolvedValue(bad);
+            expect(await appConfigService.getNewSchemaMinVersionCode()).toBeNull();
+        }
+    });
+
+    it("config read fails -> null", async () => {
+        getValue.mockRejectedValue(new Error("db down"));
+        expect(await appConfigService.getNewSchemaMinVersionCode()).toBeNull();
+    });
+});
