diff --git a/tests/envelope.test.ts b/tests/envelope.test.ts
new file mode 100644
index 0000000..516b6a4
--- /dev/null
+++ b/tests/envelope.test.ts
@@ -0,0 +1,130 @@
+import { describe, it, expect } from "vitest";
+import { pushRequestSchema, pullRequestSchema } from "../src/contract/envelope.js";
+
+/**
+ * 2.R step 3 (R6, R10) — push/pull request shape.
+ * op = INSERT | UPDATE | DELETE, no base_seq, last_synced_version sent once per request.
+ */
+
+const BILL_ID = "01900000-0000-7000-8000-0000000000b1";
+const CAT_ID = "01900000-0000-7000-8000-000000000001";
+const OP_ID = "01900000-0000-7000-8000-0000000000e1";
+
+const billData = {
+    id: BILL_ID,
+    category_id: CAT_ID,
+    amount_paise: 4500,
+    type: "E",
+    date: "2026-10-18 10:30:00",
+    title: "Tea",
+    description: null,
+};
+
+function billOp(overrides: Record<string, unknown> = {}) {
+    return { op_id: OP_ID, entity: "bill", id: BILL_ID, op: "INSERT", data: billData, ...overrides };
+}
+
+function push(ops: unknown[], extra: Record<string, unknown> = {}) {
+    return pushRequestSchema.safeParse({ last_synced_version: 0, ops: ops, ...extra });
+}
+
+describe("push request — valid", () => {
+    it("accepts INSERT with data", () => {
+        expect(push([billOp()]).success).toBe(true);
+    });
+
+    it("accepts UPDATE with data", () => {
+        expect(push([billOp({ op: "UPDATE" })]).success).toBe(true);
+    });
+
+    it("accepts DELETE without data", () => {
+        expect(push([{ op_id: OP_ID, entity: "bill", id: BILL_ID, op: "DELETE" }]).success).toBe(true);
+    });
+
+    it("accepts several entities in one push", () => {
+        const category = { op_id: OP_ID, entity: "category", id: CAT_ID, op: "INSERT",
+            data: { id: CAT_ID, name: "Food", type: "E", parent_id: null, icon: null } };
+        expect(push([category, billOp()]).success).toBe(true);
+    });
+});
+
+describe("push request — invalid op", () => {
+    it("rejects DELETE with data", () => {
+        expect(push([billOp({ op: "DELETE" })]).success).toBe(false);
+    });
+
+    it("rejects INSERT without data", () => {
+        expect(push([billOp({ data: undefined })]).success).toBe(false);
+    });
+
+    it("rejects old op value 'upsert'", () => {
+        expect(push([billOp({ op: "upsert" })]).success).toBe(false);
+    });
+
+    it("rejects old field 'kind'", () => {
+        const op: Record<string, unknown> = billOp({ kind: "upsert" });
+        delete op.op;
+        expect(push([op]).success).toBe(false);
+    });
+
+    it("rejects base_seq (removed)", () => {
+        expect(push([billOp({ base_seq: 3 })]).success).toBe(false);
+    });
+
+    it("rejects data.id different from id", () => {
+        expect(push([billOp({ data: { ...billData, id: CAT_ID } })]).success).toBe(false);
+    });
+
+    it("rejects user_id inside data", () => {
+        expect(push([billOp({ data: { ...billData, user_id: 5 } })]).success).toBe(false);
+    });
+
+    it("rejects uppercase uuid", () => {
+        expect(push([billOp({ op_id: OP_ID.toUpperCase() })]).success).toBe(false);
+    });
+
+    it("rejects unknown entity", () => {
+        expect(push([billOp({ entity: "users" })]).success).toBe(false);
+    });
+});
+
+describe("push request — envelope", () => {
+    it("rejects empty ops", () => {
+        expect(push([]).success).toBe(false);
+    });
+
+    it("rejects missing last_synced_version", () => {
+        expect(pushRequestSchema.safeParse({ ops: [billOp()] }).success).toBe(false);
+    });
+
+    it("rejects negative last_synced_version", () => {
+        expect(push([billOp()], { last_synced_version: -1 }).success).toBe(false);
+    });
+
+    it("rejects non-integer last_synced_version", () => {
+        expect(push([billOp()], { last_synced_version: 1.5 }).success).toBe(false);
+    });
+
+    it("rejects extra top-level keys", () => {
+        expect(push([billOp()], { user_id: 5 }).success).toBe(false);
+    });
+});
+
+describe("pull request", () => {
+    it("accepts last_synced_version 0 (new phone)", () => {
+        expect(pullRequestSchema.safeParse({ last_synced_version: 0 }).success).toBe(true);
+    });
+
+    it("accepts a positive last_synced_version", () => {
+        expect(pullRequestSchema.safeParse({ last_synced_version: 25 }).success).toBe(true);
+    });
+
+    it("rejects old field 'cursor'", () => {
+        expect(pullRequestSchema.safeParse({ cursor: 25 }).success).toBe(false);
+    });
+
+    it("rejects negative or missing last_synced_version", () => {
+        expect(pullRequestSchema.safeParse({ last_synced_version: -1 }).success).toBe(false);
+        expect(pullRequestSchema.safeParse({}).success).toBe(false);
+    });
+});
diff --git a/tests/syncLimits.test.ts b/tests/syncLimits.test.ts
new file mode 100644
index 0000000..c79bd41
--- /dev/null
+++ b/tests/syncLimits.test.ts
@@ -0,0 +1,58 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+/**
+ * 2.R step 3 (R7) — logWindowDays limit (server change_log window, P3-D2).
+ * config table is mocked: no database needed.
+ */
+
+const getValue = vi.fn();
+vi.mock("../src/repositories/appConfig.repository.js", () => ({
+    appConfigRepository: { getValue: (key: string) => getValue(key) },
+}));
+
+const { syncLimitsService } = await import("../src/servies/syncLimits.service.js");
+const { DEFAULT_SYNC_LIMITS, SYNC_LIMIT_KEYS } = await import("../src/contract/limits.js");
+
+beforeEach(() => {
+    getValue.mockReset();
+});
+
+describe("logWindowDays", () => {
+    it("default is 60 days", () => {
+        expect(DEFAULT_SYNC_LIMITS.logWindowDays).toBe(60);
+        expect(SYNC_LIMIT_KEYS.logWindowDays).toBe("sync_log_window_days");
+    });
+
+    it("uses a valid config override", async () => {
+        getValue.mockImplementation(async (key: string) => (key === "sync_log_window_days" ? "30" : null));
+        const limits = await syncLimitsService.getLimits();
+        expect(limits.logWindowDays).toBe(30);
+    });
+
+    it("falls back to 60 when the key is missing", async () => {
+        getValue.mockResolvedValue(null);
+        const limits = await syncLimitsService.getLimits();
+        expect(limits.logWindowDays).toBe(60);
+    });
+
+    it("falls back to 60 on invalid values", async () => {
+        for (const bad of ["abc", "0", "-5", ""]) {
+            getValue.mockImplementation(async (key: string) => (key === "sync_log_window_days" ? bad : null));
+            const limits = await syncLimitsService.getLimits();
+            expect(limits.logWindowDays).toBe(60);
+        }
+    });
+
+    it("falls back to 60 when the config read fails", async () => {
+        getValue.mockRejectedValue(new Error("db down"));
+        const limits = await syncLimitsService.getLimits();
+        expect(limits.logWindowDays).toBe(60);
+    });
+
+    it("other limits still work", async () => {
+        getValue.mockResolvedValue(null);
+        const limits = await syncLimitsService.getLimits();
+        expect(limits.maxPushOps).toBe(500);
+        expect(limits.pullPageSize).toBe(500);
+    });
+});
