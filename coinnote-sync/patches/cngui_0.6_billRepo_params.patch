+// UUID format (any version), e.g. 0190a1b2-3c4d-7e8f-9a0b-1c2d3e4f5a6b
+const UUID_PATTERN = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
+
+// turns "1,2,3" (or "uuid1,uuid2") into placeholders "?,?,?" and the id values
+// - whole number -> kept as number (current integer ids)
+// - UUID         -> kept as lowercase text (ids after UUID migration)
+// - anything else is dropped, so nothing from the string goes into the SQL text
+function buildIdList(ids: string): { placeholders: string; values: (number | string)[] } {
+  const values: (number | string)[] = [];
+  const parts = ids.split(",");
+  for (const part of parts) {
+    const text = part.trim();
+    if (text === "") {
+      continue;
+    }
+    if (UUID_PATTERN.test(text)) {
+      values.push(text.toLowerCase());
+    } else if (Number.isInteger(Number(text))) {
+      values.push(Number(text));
+    }
+  }
+  const placeholders = values.map(() => "?").join(",");
+  return { placeholders, values };
+}
