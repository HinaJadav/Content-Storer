@@ -0,0 +1,40 @@
+import { ResponseParams } from "@/interfaces/interface";
+import { response } from "@/util/response";
+import { copyAllData, createNewTables } from "./copyData";
+import { MigrationDb } from "./migrationDb";
+import { swapTables } from "./swapTables";
+import { verifyCopy } from "./verifyCopy";
+
+/**
+ * UUID migration — full run (2.1d).
+ * One transaction: create new tables -> copy -> verify -> swap -> commit.
+ * Any error or failed check rolls back: old tables stay exactly as they were and
+ * PRAGMA user_version stays 0, so the next launch can try again.
+ *
+ * NOT wired into the app yet (Phase 2 last step, together with 2.3 - 2.6).
+ *
+ * @param newId - creates one new id (uuid v7 in the app)
+ * @param now - created_at for outbox rows ("YYYY-MM-DD HH:MM:SS")
+ * @returns ResponseParams, IsError true with the reason when rolled back
+ */
+export function migrateToUuid(db: MigrationDb, newId: () => string, now: string): ResponseParams<null> {
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    createNewTables(db);
+    const copy = copyAllData(db, newId, now);
+
+    const problems = verifyCopy(db, copy.idMaps);
+    if (problems.length > 0) {
+      db.exec("ROLLBACK");
+      return response(null, true, "verify failed: " + problems.join("; "), 500);
+    }
+
+    swapTables(db);
+    db.exec("COMMIT");
+    return response(null, false, "", 200);
+  } catch (error) {
+    db.exec("ROLLBACK");
+    const message = error instanceof Error ? error.message : String(error);
+    return response(null, true, "uuid migration failed: " + message, 500);
+  }
+}
diff --git a/data/database/uuidMigration/swapTables.ts b/data/database/uuidMigration/swapTables.ts
