+import { db } from "./db.config";
+import { SqlDb } from "./sqlDb";
+import { expoMigrationDb } from "./uuidMigration/expoMigrationDb";
+
+/**
+ * The app's database as a SqlDb, for the new repositories (data/database/syncRepo).
+ * Wraps the same singleton `db` (db.config.ts), so the app still has ONE connection.
+ * Tests replace this module with an in-memory SQLite.
+ */
+export const localDb: SqlDb = expoMigrationDb(db);
diff --git a/data/database/syncRepo/categoryRepo.ts b/data/database/syncRepo/categoryRepo.ts
new file mode 100644
index 0000000..811a28b
--- /dev/null
+++ b/data/database/syncRepo/categoryRepo.ts
@@ -0,0 +1,235 @@
+import { ResponseParams } from "@/interfaces/interface";
+import { response } from "@/util/response";
+import { v7 as uuidv7 } from "uuid";
+import { localDb } from "../localDb";
+import { addOutboxOp, OutboxEntity } from "../sync/outboxRepo";
+import { inTransaction, NotFoundError } from "./transaction";
+import { CategoryRow } from "./types";
+
+/**
+ * Category repository for the new (UUID) tables.
+ * Same function names as dbRepository/categoriesRepo.ts so screens switch by import path.
+ * Every write also writes its sync_outbox op in the same transaction.
+ * Delete = cascade (P2-D2): sub-categories, bills, budgets and attachments go too.
+ */
+
+// SELECT helper: rows or error, in ResponseParams format
+function select<T>(sql: string, params: unknown[] = []): ResponseParams<T[]> {
+  try {
+    return response(localDb.all<T>(sql, params), false, "", 200);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return response([], true, message, 500);
+  }
+}
+
+// wire columns sent to the server (registry 1.1a)
+function wireData(row: CategoryRow): Record<string, unknown> {
+  return { id: row.id, name: row.name, type: row.type, parent_id: row.parent_id, icon: row.icon };
+}
+
+// adds one outbox op, throws on error so the transaction rolls back
+function outbox(
+  entity: OutboxEntity,
+  userId: number,
+  recordId: string,
+  op: "INSERT" | "UPDATE" | "DELETE",
+  data: Record<string, unknown> | null,
+): void {
+  const result = addOutboxOp(localDb, { userId: userId, entity: entity, recordId: recordId, op: op, data: data });
+  if (result.IsError) {
+    throw new Error(result.ErrorMessage);
+  }
+}
+
+/**
+ * get categories: top level of a type (parentId null) or children of a parent, filtered by name
+ */
+export async function getCategories(
+  type: RecordType,
+  search: string,
+  parentId: string | null,
+  userId: number,
+): Promise<ResponseParams<CategoryRow[]>> {
+  const whereParent = parentId === null ? "parent_id IS NULL AND type = ?" : "parent_id = ?";
+  const parentParam = parentId === null ? type : parentId;
+  return select<CategoryRow>(
+    `SELECT * FROM category
+     WHERE name LIKE ? AND user_id = ? AND ${whereParent}
+     ORDER BY name ASC`,
+    [`%${search}%`, userId, parentParam],
+  );
+}
+
+// number of direct child categories
+export async function getChildCategoriesCount(parentId: string): Promise<ResponseParams<{ count: number }[]>> {
+  return select(`SELECT COUNT(*) AS count FROM category WHERE parent_id = ?`, [parentId]);
+}
+
+// number of child categories that have a budget for the given month (budget card, past month)
+export async function getCategoryHaveChildWithBudgetSet(categoryId: string, month: number, year: number): Promise<ResponseParams<{ count: number }[]>> {
+  return select(
+    `SELECT COUNT(*) AS count FROM category c
+     WHERE EXISTS (SELECT 1 FROM budget b WHERE b.category_id = c.id AND b.month = ? AND b.year = ?)
+     AND c.parent_id = ?`,
+    [month, year, categoryId],
+  );
+}
+
+export async function getTitleById(categoryId: string, userId: number): Promise<ResponseParams<{ name: string }[]>> {
+  return select(`SELECT name FROM category WHERE id = ? AND user_id = ?`, [categoryId, userId]);
+}
+
+export async function getCatByName(name: string, userId: number): Promise<ResponseParams<CategoryRow[]>> {
+  return select(`SELECT * FROM category WHERE name = ? AND user_id = ? LIMIT 1`, [name, userId]);
+}
+
+export async function getCatById(categoryId: string, userId: number): Promise<ResponseParams<CategoryRow[]>> {
+  return select(`SELECT * FROM category WHERE id = ? AND user_id = ?`, [categoryId, userId]);
+}
+
+// the category and all its descendants
+export async function GetAllChildCatIds(catId: string): Promise<ResponseParams<{ ids: string }[]>> {
+  return select(
+    `WITH RECURSIVE category_tree AS (
+       SELECT c.id AS id FROM category c WHERE c.id = ?
+       UNION ALL
+       SELECT c.id AS id FROM category c INNER JOIN category_tree ct ON c.parent_id = ct.id
+     )
+     SELECT DISTINCT ct.id AS ids FROM category_tree ct`,
+    [catId],
+  );
+}
+
+/**
+ * insert (id empty) or update (id given) a category + its outbox op.
+ * @returns Data = id of the saved category
+ */
+export async function insertOrUpdateCategory(category: CategoryRow): Promise<ResponseParams<string | null>> {
+  return inTransaction(localDb, () => {
+    if (category.id) {
+      const found = localDb.all(`SELECT id FROM category WHERE id = ? AND user_id = ?`, [category.id, category.user_id]);
+      if (found.length === 0) {
+        throw new NotFoundError("category not found");
+      }
+      localDb.run(
+        `UPDATE category SET name = ?, type = ?, parent_id = ?, root_category_id = ?, icon = ?, auto_repeat_budget = ?
+         WHERE id = ? AND user_id = ?`,
+        [category.name, category.type, category.parent_id, category.root_category_id, category.icon, 0, category.id, category.user_id],
+      );
+      outbox("category", category.user_id, category.id, "UPDATE", wireData(category));
+      return category.id;
+    }
+
+    const saved: CategoryRow = { ...category, id: uuidv7(), auto_repeat_budget: 0 };
+    localDb.run(
+      `INSERT INTO category (id, user_id, name, type, parent_id, root_category_id, icon, auto_repeat_budget)
+       VALUES (?, ?, ?, ?, ?, ?, ?, 0)`,
+      [saved.id, saved.user_id, saved.name, saved.type, saved.parent_id, saved.root_category_id, saved.icon],
+    );
+    outbox("category", saved.user_id, saved.id, "INSERT", wireData(saved));
+    return saved.id;
+  }, "save category failed");
+}
+
+// category tree of one user, deepest first (children are deleted before parents)
+function categoryTreeDeepestFirst(categoryId: string, userId: number): string[] {
+  const rows = localDb.all<{ id: string; depth: number }>(
+    `WITH RECURSIVE tree AS (
+       SELECT id, 0 AS depth FROM category WHERE id = ? AND user_id = ?
+       UNION ALL
+       SELECT c.id, t.depth + 1 FROM category c INNER JOIN tree t ON c.parent_id = t.id WHERE c.user_id = ?
+     )
+     SELECT id, depth FROM tree ORDER BY depth DESC`,
+    [categoryId, userId, userId],
+  );
+  return rows.map((row) => row.id);
+}
+
+// "?, ?, ?" for an IN (...) list
+function placeholders(count: number): string {
+  return new Array(count).fill("?").join(", ");
+}
+
+/**
+ * What a cascade delete would remove (for the GitHub-style confirm alert).
+ * @returns Data = { childCategories, records, drafts, budgets }
+ */
+export async function countCategoryDependents(
+  categoryId: string,
+  userId: number,
+): Promise<ResponseParams<{ childCategories: number; records: number; drafts: number; budgets: number } | null>> {
+  try {
+    const tree = categoryTreeDeepestFirst(categoryId, userId);
+    if (tree.length === 0) {
+      return response(null, true, "category not found", 404);
+    }
+    const marks = placeholders(tree.length);
+    const bills = localDb.all<{ records: number; drafts: number }>(
+      `SELECT COUNT(*) AS records, COALESCE(SUM(CASE WHEN billstatus = 'D' THEN 1 ELSE 0 END), 0) AS drafts
+       FROM bill WHERE user_id = ? AND category_id IN (${marks})`,
+      [userId, ...tree],
+    )[0];
+    const budgets = localDb.all<{ n: number }>(
+      `SELECT COUNT(*) AS n FROM budget WHERE user_id = ? AND category_id IN (${marks})`,
+      [userId, ...tree],
+    )[0];
+    return response({
+      childCategories: tree.length - 1,
+      records: Number(bills.records),
+      drafts: Number(bills.drafts),
+      budgets: Number(budgets.n),
+    }, false, "", 200);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return response(null, true, message, 500);
+  }
+}
+
+/**
+ * Cascade delete in one transaction (P2-D2):
+ * bills (+ their attachments) -> budgets -> sub-categories (deepest first) -> the category.
+ * One DELETE outbox op per row; unconfirmed ATT drafts write nothing (never synced).
+ */
+export function DeleteCategory(categoryId: string, userId: number): ResponseParams<null> {
+  const result = inTransaction(localDb, () => {
+    const tree = categoryTreeDeepestFirst(categoryId, userId);
+    if (tree.length === 0) {
+      throw new NotFoundError("category not found");
+    }
+    const marks = placeholders(tree.length);
+
+    const bills = localDb.all<{ id: string; billstatus: string }>(
+      `SELECT id, billstatus FROM bill WHERE user_id = ? AND category_id IN (${marks})`,
+      [userId, ...tree],
+    );
+    for (const bill of bills) {
+      localDb.run(`DELETE FROM bill_docurl WHERE bill_id = ?`, [bill.id]);
+      localDb.run(`DELETE FROM bill WHERE id = ? AND user_id = ?`, [bill.id, userId]);
+      if (bill.billstatus !== "D") {
+        outbox("bill", userId, bill.id, "DELETE", null);
+      }
+    }
+
+    const budgets = localDb.all<{ id: string }>(
+      `SELECT id FROM budget WHERE user_id = ? AND category_id IN (${marks})`,
+      [userId, ...tree],
+    );
+    for (const budget of budgets) {
+      localDb.run(`DELETE FROM budget WHERE id = ? AND user_id = ?`, [budget.id, userId]);
+      outbox("budget", userId, budget.id, "DELETE", null);
+    }
+
+    for (const id of tree) {
+      localDb.run(`DELETE FROM category WHERE id = ? AND user_id = ?`, [id, userId]);
+      outbox("category", userId, id, "DELETE", null);
+    }
+    return null;
+  }, "delete category failed");
+  return result as ResponseParams<null>;
+}
+
+// same cascade as DeleteCategory (old repo had both names)
+export async function deleteCategoryById(categoryId: string, userId: number): Promise<ResponseParams<null>> {
+  return DeleteCategory(categoryId, userId);
+}
diff --git a/data/database/syncRepo/transaction.ts b/data/database/syncRepo/transaction.ts
