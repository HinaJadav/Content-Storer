index 0000000..6e95195
--- /dev/null
+++ b/data/database/syncRepo/transaction.ts
@@ -0,0 +1,26 @@
+import { ResponseParams } from "@/interfaces/interface";
+import { response } from "@/util/response";
+import { SqlDb } from "../sqlDb";
+
+/**
+ * Runs `work` inside one SQLite transaction: real table change + its sync_outbox op
+ * save together or not at all. Any thrown error rolls back.
+ *
+ * @returns ResponseParams with the value returned by `work` as Data
+ */
+export function inTransaction<T>(db: SqlDb, work: () => T, errorPrefix: string): ResponseParams<T | null> {
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    const value = work();
+    db.exec("COMMIT");
+    return response(value, false, "", 200);
+  } catch (error) {
+    db.exec("ROLLBACK");
+    const message = error instanceof Error ? error.message : String(error);
+    const status = error instanceof NotFoundError ? 404 : 500;
+    return response(null, true, errorPrefix + ": " + message, status);
+  }
+}
+
+// thrown inside a transaction when the row does not exist for this user
+export class NotFoundError extends Error {}
