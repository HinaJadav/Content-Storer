+/**
+ * Row shapes of the new (UUID) local tables (approved in 2.1b).
+ */
+export interface CategoryRow {
+  id: string;                      // uuid; "" when creating a new category
+  user_id: number;
+  name: string;
+  type: string;                    // 'I' / 'E'
+  parent_id: string | null;
+  root_category_id: string | null;
+  icon: string | null;
+  auto_repeat_budget: number;      // 0 / 1
+}
diff --git a/tests/syncRepo/categoryRepo.test.ts b/tests/syncRepo/categoryRepo.test.ts
new file mode 100644
index 0000000..393b5c2
--- /dev/null
+++ b/tests/syncRepo/categoryRepo.test.ts
@@ -0,0 +1,174 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { useFreshDb, testLocalDb } from "./testDb";
+
+vi.mock("@/data/database/localDb", () => ({ localDb: testLocalDb }));
+
+const repo = await import("@/data/database/syncRepo/categoryRepo");
+
+/**
+ * 2.3a — category repository on the new (UUID) tables.
+ * Same function names as dbRepository/categoriesRepo.ts; every write also writes
+ * its sync_outbox op in the same transaction. Delete = cascade (P2-D2).
+ */
+
+let raw: ReturnType<typeof useFreshDb>;
+const U = 5;
+
+beforeEach(() => {
+  raw = useFreshDb();
+});
+
+function outbox() {
+  return raw.prepare("SELECT entity, record_id, op, data FROM sync_outbox ORDER BY seq").all() as any[];
+}
+
+async function addCat(name: string, type: "I" | "E", parentId: string | null = null, userId = U) {
+  const result = await repo.insertOrUpdateCategory({ id: "", user_id: userId, name: name, type: type, parent_id: parentId, root_category_id: parentId, icon: "x.png", auto_repeat_budget: 0 });
+  return result.Data as string;
+}
+
+function addBill(id: string, categoryId: string | null, amountPaise: number, status = "C") {
+  raw.prepare(`INSERT INTO bill (id, user_id, category_id, from_acc_id, amount_paise, type, date, title, billstatus) VALUES (?, ?, ?, 0, ?, 'E', '2026-10-01 10:00:00', 't', ?)`).run(id, U, categoryId, amountPaise, status);
+}
+
+function addBudget(id: string, categoryId: string) {
+  raw.prepare(`INSERT INTO budget (id, user_id, category_id, year, month, type, limit_paise, used_paise) VALUES (?, ?, ?, 2026, 10, 'M', 1000, 0)`).run(id, U, categoryId);
+}
+
+describe("insertOrUpdateCategory", () => {
+  it("insert: new uuid v7, row saved, outbox INSERT with wire columns", async () => {
+    const result = await repo.insertOrUpdateCategory({ id: "", user_id: U, name: "Food", type: "E", parent_id: null, root_category_id: null, icon: "f.png", auto_repeat_budget: 0 });
+    expect(result.IsError).toBe(false);
+    const id = result.Data as string;
+    expect(id).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
+    const row = raw.prepare("SELECT * FROM category WHERE id = ?").get(id) as any;
+    expect(row).toMatchObject({ user_id: U, name: "Food", type: "E", icon: "f.png" });
+    expect(outbox()).toEqual([{ entity: "category", record_id: id, op: "INSERT", data: JSON.stringify({ id: id, name: "Food", type: "E", parent_id: null, icon: "f.png" }) }]);
+  });
+
+  it("update: row changed, outbox collapses into the pending INSERT", async () => {
+    const id = await addCat("Food", "E");
+    const result = await repo.insertOrUpdateCategory({ id: id, user_id: U, name: "Food & Dining", type: "E", parent_id: null, root_category_id: null, icon: "g.png", auto_repeat_budget: 0 });
+    expect(result.IsError).toBe(false);
+    expect((raw.prepare("SELECT name FROM category WHERE id = ?").get(id) as any).name).toBe("Food & Dining");
+    const ops = outbox();
+    expect(ops.length).toBe(1);
+    expect(ops[0].op).toBe("INSERT");
+    expect(JSON.parse(ops[0].data).name).toBe("Food & Dining");
+  });
+
+  it("update of another user's category changes nothing", async () => {
+    const id = await addCat("Food", "E");
+    const result = await repo.insertOrUpdateCategory({ id: id, user_id: 99, name: "Hacked", type: "E", parent_id: null, root_category_id: null, icon: "x", auto_repeat_budget: 0 });
+    expect(result.IsError).toBe(true);
+    expect((raw.prepare("SELECT name FROM category WHERE id = ?").get(id) as any).name).toBe("Food");
+  });
+});
+
+describe("reads", () => {
+  it("getCategories: top level by type, children by parent, search by name", async () => {
+    const food = await addCat("Food", "E");
+    await addCat("Salary", "I");
+    await addCat("Tea", "E", food);
+    await addCat("Groceries", "E", food);
+    const top = await repo.getCategories("E", "", null, U);
+    expect((top.Data as any[]).map((c) => c.name)).toEqual(["Food"]);
+    const children = await repo.getCategories("E", "", food, U);
+    expect((children.Data as any[]).map((c) => c.name)).toEqual(["Groceries", "Tea"]);
+    const search = await repo.getCategories("E", "Te", food, U);
+    expect((search.Data as any[]).map((c) => c.name)).toEqual(["Tea"]);
+  });
+
+  it("getCatById / getTitleById / getCatByName only for the owner", async () => {
+    const food = await addCat("Food", "E");
+    expect(((await repo.getCatById(food, U)).Data as any[])[0].name).toBe("Food");
+    expect(((await repo.getCatById(food, 99)).Data as any[]).length).toBe(0);
+    expect(((await repo.getTitleById(food, U)).Data as any[])[0].name).toBe("Food");
+    expect(((await repo.getCatByName("Food", U)).Data as any[])[0].id).toBe(food);
+  });
+
+  it("getChildCategoriesCount and GetAllChildCatIds (recursive)", async () => {
+    const food = await addCat("Food", "E");
+    const tea = await addCat("Tea", "E", food);
+    const greenTea = await addCat("Green tea", "E", tea);
+    expect(((await repo.getChildCategoriesCount(food)).Data as any[])[0].count).toBe(1);
+    const ids = ((await repo.GetAllChildCatIds(food)).Data as any[]).map((r) => r.ids).sort();
+    expect(ids).toEqual([food, tea, greenTea].sort());
+  });
+
+  it("getCategoryHaveChildWithBudgetSet", async () => {
+    const food = await addCat("Food", "E");
+    const tea = await addCat("Tea", "E", food);
+    addBudget("bu1", tea);
+    expect(((await repo.getCategoryHaveChildWithBudgetSet(food, 10, 2026)).Data as any[])[0].count).toBe(1);
+    expect(((await repo.getCategoryHaveChildWithBudgetSet(food, 11, 2026)).Data as any[])[0].count).toBe(0);
+  });
+});
+
+describe("countCategoryDependents (for the delete alert)", () => {
+  it("counts sub-categories, records, drafts and budgets of the whole tree", async () => {
+    const food = await addCat("Food", "E");
+    const tea = await addCat("Tea", "E", food);
+    await addCat("Green tea", "E", tea);
+    addBill("b1", food, 100);
+    addBill("b2", tea, 200);
+    addBill("b3", tea, 300, "D");
+    addBudget("bu1", food);
+    const result = await repo.countCategoryDependents(food, U);
+    expect(result.Data).toEqual({ childCategories: 2, records: 3, drafts: 1, budgets: 1 });
+  });
+});
+
+describe("cascade delete (DeleteCategory / deleteCategoryById)", () => {
+  it("deletes the category, its sub-categories, bills, budgets and attachments", async () => {
+    const food = await addCat("Food", "E");
+    const tea = await addCat("Tea", "E", food);
+    const other = await addCat("Other", "E");
+    addBill("b1", food, 100);
+    addBill("b2", tea, 200);
+    addBill("b9", other, 900);
+    addBudget("bu1", tea);
+    raw.prepare("INSERT INTO bill_docurl (bill_id, url) VALUES ('b2', 'file://r.jpg')").run();
+    const result = repo.DeleteCategory(food, U);
+    expect(result.IsError).toBe(false);
+    expect((raw.prepare("SELECT COUNT(*) AS n FROM category").get() as any).n).toBe(1);
+    expect((raw.prepare("SELECT id FROM bill").all() as any[]).map((b) => b.id)).toEqual(["b9"]);
+    expect((raw.prepare("SELECT COUNT(*) AS n FROM budget").get() as any).n).toBe(0);
+    expect((raw.prepare("SELECT COUNT(*) AS n FROM bill_docurl").get() as any).n).toBe(0);
+  });
+
+  it("outbox: DELETE per row in order bills -> budgets -> sub-categories -> category; drafts write nothing", async () => {
+    const food = await addCat("Food", "E");
+    const tea = await addCat("Tea", "E", food);
+    addBill("b1", food, 100);
+    addBill("b3", tea, 300, "D");
+    addBudget("bu1", tea);
+    raw.exec("DELETE FROM sync_outbox"); // pretend the inserts were already synced
+    repo.DeleteCategory(food, U);
+    const ops = outbox().map((o) => o.entity + ":" + o.op + ":" + o.record_id);
+    expect(ops).toEqual(["bill:DELETE:b1", "budget:DELETE:bu1", "category:DELETE:" + tea, "category:DELETE:" + food]);
+    expect(outbox().every((o) => o.data === null)).toBe(true);
+  });
+
+  it("not yet synced rows: INSERT + DELETE collapse to nothing", async () => {
+    const food = await addCat("Food", "E");
+    await addCat("Tea", "E", food);
+    repo.DeleteCategory(food, U);
+    expect(outbox().length).toBe(0);
+  });
+
+  it("deleteCategoryById does the same cascade", async () => {
+    const food = await addCat("Food", "E");
+    addBill("b1", food, 100);
+    const result = await repo.deleteCategoryById(food, U);
+    expect(result.IsError).toBe(false);
+    expect((raw.prepare("SELECT COUNT(*) AS n FROM bill").get() as any).n).toBe(0);
+  });
+
+  it("another user's category is not deleted", async () => {
+    const food = await addCat("Food", "E");
+    const result = repo.DeleteCategory(food, 99);
+    expect(result.IsError).toBe(true);
+    expect((raw.prepare("SELECT COUNT(*) AS n FROM category").get() as any).n).toBe(1);
+  });
+});
diff --git a/tests/syncRepo/testDb.ts b/tests/syncRepo/testDb.ts
new file mode 100644
index 0000000..3d613ad
--- /dev/null
+++ b/tests/syncRepo/testDb.ts
@@ -0,0 +1,30 @@
+import { createOldDb, wrap } from "../uuidMigration/oldDb";
+import { migrateToUuid } from "@/data/database/uuidMigration/migrateToUuid";
+import { SqlDb } from "@/data/database/sqlDb";
+
+/**
+ * Test helper for the new repositories: a fresh in-memory phone DB already in the
+ * new (UUID) shape. Tests mock "@/data/database/localDb" with `testLocalDb`, which
+ * forwards to whatever DB `useFreshDb()` created last.
+ */
+
+let current: ReturnType<typeof createOldDb> | null = null;
+
+export function useFreshDb() {
+  const raw = createOldDb();
+  migrateToUuid(wrap(raw), () => "unused", "2026-10-25 09:00:00");
+  current = raw;
+  return raw;
+}
+
+export const testLocalDb: SqlDb = {
+  exec(sql: string) {
+    wrap(current!).exec(sql);
+  },
+  run(sql: string, params: unknown[] = []) {
+    wrap(current!).run(sql, params);
+  },
+  all<T>(sql: string, params: unknown[] = []): T[] {
+    return wrap(current!).all<T>(sql, params);
+  },
+};
