+describe("orphan rows (category already deleted) -> 'Uncategorized'", () => {
+  function migrateWith(extraSql: string) {
+    const raw = createOldDb();
+    raw.exec(`
+      INSERT INTO category (id, name, userid, parentid, typeofcategory) VALUES (1, 'Food', 5, NULL, 'E');
+      INSERT INTO category (id, name, userid, parentid, typeofcategory) VALUES (2, 'Salary', 6, NULL, 'I');
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (10, 100, 1, 0, 5, '2026-10-01 10:00:00', 'E', 'ok bill');
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (11, 5, 2, 0, 6, '2026-10-01 10:00:00', 'I', 'user 6 ok');
+    `);
+    raw.exec(extraSql);
+    const db = wrap(raw);
+    createNewTables(db);
+    const result = copyAllData(db, fakeIdGenerator(), NOW);
+    return { raw, db, result };
+  }
+
+  function uncategorized(db: any, userId: number, type: string) {
+    return db.all("SELECT * FROM category_new WHERE name = 'Uncategorized' AND user_id = ? AND type = ?", [userId, type]);
+  }
+
+  it("orphan expense bill -> 'Uncategorized' (E) of that user", () => {
+    const { db } = migrateWith(`INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (20, 30, 99, 0, 5, '2026-10-02 10:00:00', 'E', 'orphan E');`);
+    const cat = uncategorized(db, 5, "E");
+    expect(cat.length).toBe(1);
+    expect(db.all<any>("SELECT category_id FROM bill_new WHERE title = 'orphan E'")[0].category_id).toBe(cat[0].id);
+    expect(cat[0].parent_id).toBeNull();
+  });
+
+  it("orphan income bill -> 'Uncategorized' (I)", () => {
+    const { db } = migrateWith(`INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (20, 30, 99, 0, 5, '2026-10-02 10:00:00', 'I', 'orphan I');`);
+    const cat = uncategorized(db, 5, "I");
+    expect(cat.length).toBe(1);
+    expect(db.all<any>("SELECT category_id FROM bill_new WHERE title = 'orphan I'")[0].category_id).toBe(cat[0].id);
+  });
+
+  it("orphan transfer bill -> 'Uncategorized' (E)", () => {
+    const { db } = migrateWith(`INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (20, 30, 99, 0, 5, '2026-10-02 10:00:00', 'T', 'orphan T');`);
+    expect(uncategorized(db, 5, "E").length).toBe(1);
+  });
+
+  it("several orphans of same user and type share one 'Uncategorized'", () => {
+    const { db } = migrateWith(`
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (20, 30, 99, 0, 5, '2026-10-02 10:00:00', 'E', 'o1');
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (21, 40, 98, 0, 5, '2026-10-02 10:00:00', 'E', 'o2');
+    `);
+    expect(uncategorized(db, 5, "E").length).toBe(1);
+  });
+
+  it("existing 'Uncategorized' of the user is reused, no duplicate", () => {
+    const { db, result } = migrateWith(`
+      INSERT INTO category (id, name, userid, parentid, typeofcategory) VALUES (8, 'Uncategorized', 5, NULL, 'E');
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (20, 30, 99, 0, 5, '2026-10-02 10:00:00', 'E', 'orphan E');
+    `);
+    const cat = uncategorized(db, 5, "E");
