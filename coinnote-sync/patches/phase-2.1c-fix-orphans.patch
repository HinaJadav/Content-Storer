+const UNCATEGORIZED_NAME = "Uncategorized";
+
+// true when the row points to a category id that no longer exists (0 / null = no category, not an orphan)
+function isOrphanLink(map: Map<number, string>, oldId: number | null): boolean {
+  if (oldId === null || oldId === undefined || oldId === 0) {
+    return false;
+  }
+  return !map.has(oldId);
+}
+
+// category type for the "Uncategorized" of an orphan bill: income -> I, expense / transfer -> E
+function uncategorizedTypeForBill(typeofbill: string): string {
+  return typeofbill === "I" ? "I" : "E";
+}
+
+/**
+ * Creates (or reuses) one "Uncategorized" category per user and type that has orphan rows.
+ * Must run after copyCategories (so a reused one is already in category_new) and before
+ * budgets / bills (so their outbox ops come after the category op).
+ *
+ * @returns key "userId:type" -> category id
+ */
+function prepareUncategorized(db: MigrationDb, maps: IdMaps, newId: () => string, now: string): Map<string, string> {
+  const result = new Map<string, string>();
+
+  // which user + type pairs need one
+  const neededKeys = new Set<string>();
+  const needed: { userId: number; type: string }[] = [];
+  const addNeeded = (userId: number, type: string) => {
+    const key = userId + ":" + type;
+    if (!neededKeys.has(key)) {
+      neededKeys.add(key);
+      needed.push({ userId: userId, type: type });
+    }
+  };
+
+  const bills = db.all<any>(`SELECT userid, toaccid, typeofbill FROM bill ORDER BY id`);
+  for (const bill of bills) {
+    if (isOrphanLink(maps.category, bill.toaccid)) {
+      addNeeded(bill.userid, uncategorizedTypeForBill(bill.typeofbill));
+    }
+  }
+  const budgets = db.all<any>(`SELECT userid, categoryid FROM budget ORDER BY id`);
+  for (const budget of budgets) {
+    if (isOrphanLink(maps.category, budget.categoryid)) {
+      addNeeded(budget.userid, "E");
+    }
+  }
+
+  for (const item of needed) {
+    const key = item.userId + ":" + item.type;
+
+    // reuse an existing "Uncategorized" of this user and type
+    const existing = db.all<{ id: number }>(
+      `SELECT id FROM category WHERE name = ? AND userid = ? AND typeofcategory = ? ORDER BY id LIMIT 1`,
+      [UNCATEGORIZED_NAME, item.userId, item.type],
+    );
+    if (existing.length > 0) {
+      result.set(key, maps.category.get(existing[0].id) as string);
+      continue;
+    }
+
+    const id = newId();
+    db.run(
+      `INSERT INTO category_new (id, user_id, name, type, parent_id, root_category_id, icon, auto_repeat_budget)
+       VALUES (?, ?, ?, ?, NULL, NULL, NULL, 0)`,
+      [id, item.userId, UNCATEGORIZED_NAME, item.type],
+    );
+    addOutboxInsert(db, newId, now, item.userId, "category", id, {
+      id: id,
+      name: UNCATEGORIZED_NAME,
+      type: item.type,
+      parent_id: null,
+      icon: null,
+    });
+    result.set(key, id);
+  }
+
+  return result;
+}
