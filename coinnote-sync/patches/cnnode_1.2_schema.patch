+}
+
+// =====================================================================
+// Cloud sync tables (Phase 1.2)
+// - id is a uuid created on the phone; PK is (user_id, id) so a user can
+//   only ever reach their own rows
+// - project rule: NO foreign keys at DB level. category_id / parent_id are
+//   plain columns; same-user checks are done in code (sync push)
+// - type columns are text + CHECK (CHECKs hand-written in migration)
+// - deletes remove the row; change_log keeps a 'delete' note (D3)
+// - money in whole paise (D4)
+// =====================================================================
+
+model category {
+  user_id        Int
+  id             String     @db.Uuid
+  name           String     @db.VarChar(100)
+  type           String // I | E
+  parent_id      String?    @db.Uuid
+  icon           String?    @db.VarChar(255)
+  updated_seq    BigInt
+  last_op_id     String?    @db.Uuid
+  created_at     DateTime   @default(now()) @db.Timestamptz(3)
+  updated_at     DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
+
+  @@id([user_id, id])
+  @@index([user_id, updated_seq])
+  @@index([user_id, parent_id])
+}
+
+model bill {
+  user_id      Int
+  id           String   @db.Uuid
+  category_id  String   @db.Uuid
+  amount_paise BigInt
+  type         String // I | E | T
+  date         DateTime @db.Timestamp(0) // phone local wall-clock time, no timezone
+  title        String   @db.VarChar(150)
+  description  String?  @db.VarChar(1000)
+  updated_seq  BigInt
+  last_op_id   String?  @db.Uuid
+  created_at   DateTime @default(now()) @db.Timestamptz(3)
+  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
+
+  @@id([user_id, id])
+  @@index([user_id, updated_seq])
+  @@index([user_id, category_id])
+}
+
+model budget {
+  user_id     Int
+  id          String   @db.Uuid
+  category_id String   @db.Uuid
+  year        Int
+  month       Int? // null = yearly budget
+  type        String // M | Y
+  limit_paise BigInt
+  updated_seq BigInt
+  last_op_id  String?  @db.Uuid
+  created_at  DateTime @default(now()) @db.Timestamptz(3)
+  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
+
+  @@id([user_id, id])
+  @@index([user_id, updated_seq])
+  @@index([user_id, category_id])
+}
+
+// one row per issued seq; pull reads this to find what changed after a cursor
+model change_log {
+  user_id       Int
+  seq           BigInt
+  entity        String // category | bill | budget
+  row_id        String   @db.Uuid
+  op            String // upsert | delete
+  origin_device String?  @db.Uuid // device that made the change (pull skips own changes)
+  created_at    DateTime @default(now()) @db.Timestamptz(3)
+
+  @@id([user_id, seq])
+  @@index([user_id, row_id])
+}
