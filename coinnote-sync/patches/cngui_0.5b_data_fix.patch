+/**
+ * SQL Execution Helper
+ * ---------------------
+ * This module provides a thin wrapper around the SQLite database instance
+ * to execute raw SQL queries in a clean and centralized way.
+ *
+ * Purpose:
+ * - Offer a unified API for running raw SQL statements across the app.
+ * - Reduce repeated boilerplate such as try/catch blocks and argument binding.
+ * - Keep low-level DB operations separate from repositories and services.
+ *
+ * Why Centralize Raw Execution?
+ * - Helps maintain a clean data access layer.
+ * - Ensures all SQL interactions pass through a predictable and safe path.
+ * - Allows logging, error tracking, or performance measurement in one place.
+ * - Prevents scattered “db.runSync()” calls across multiple files.
+ *
+ * Behavior:
+ * - Executes the provided SQL string directly on the singleton DB instance.
+ * - Supports both:
+ *      - `run` operations (INSERT, UPDATE, DELETE)
+ *      - `select` operations (SELECT returning rows)
+ * - Arguments can be passed as an array and are safely bound to SQL parameters.
+ * - Errors are caught and rethrown with context for easier debugging.
+ *
+ * Important Notes:
+ * - This is a low-level helper; business logic should be implemented in
+ *   repositories and services—not directly inside this file.
+ * - Avoid building dynamic SQL strings using user input. Always use
+ *   parameter binding to prevent SQL injection.
+ * - Keep the SQL here simple; complex logic belongs in repository-level helpers.
+ *
+ * Usage Example:
+ *   import { execute, query } from './execute';
+ *
+ *   // For INSERT/UPDATE/DELETE
+ *   await execute(
+ *     "INSERT INTO expenses (title, amount) VALUES (?, ?)",
+ *     ["Coffee", 120]
+ *   );
+ *
+ *   // For SELECT queries
+ *   const rows = await query(
+ *     "SELECT * FROM expenses WHERE amount > ?",
+ *     [100]
+ *   );
+ *
+ * Extendability:
+ * - Logging can be added to inspect executed SQL.
+ * - Analytics can be added to measure slow queries.
+ * - Transactions can be integrated at this layer if required.
+ */
+import { response } from "@/util/response";
+import { db } from "./db.config";
+
+// Execute a raw SQL statement (INSERT, UPDATE, DELETE)
+// Data is null; check IsError / ErrorMessage
+export function execute(sql: string, args: any[] = []) {
+  try {
+    db.runSync(sql, args);
+  } catch (error) {
+    const message = `SQL Execution Error: ${error instanceof Error ? error.message : String(error)}`;
+    return response(null, true, message, 500);
+  }
+  return response(null, false, "", 200);
+}
+
+// Execute a raw SQL query (SELECT) and return the resulting rows
+// Data is the rows array directly
+export function query<T = any>(sql: string, args: any[] = []) {
+  let result: T[] = [];
+  try {
+    result = db.getAllSync<T>(sql, args);
+  } catch (error) {
+    const message = `SQL Query Error: ${error instanceof Error ? error.message : String(error)}`;
+    return response<T[]>([], true, message, 500);
+  }
+  return response<T[]>(result, false, "", 200);
+}
+
+export function runInTransaction(fn: () => void) {
+  try {
+    db.withTransactionSync(() => {
+      fn();
+    });
+    return response(null, false, "", 200);
+  } catch (error) {
+    const message = `Transaction failed: ${error instanceof Error ? error.message : String(error)}`;
+    return response(null, true, message, 500);
+  }
+}
