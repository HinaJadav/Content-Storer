@@ -0,0 +1,66 @@
+/**
+ * Sync-ready local tables (Phase 2, approved shapes 2.1b).
+ * Created next to the old tables with a _new suffix; the swap (2.1d) drops the
+ * old tables and renames these. Indexes are created after the swap.
+ */
+export const NEW_TABLES_SQL = `
+  CREATE TABLE category_new (
+    id                 TEXT    NOT NULL PRIMARY KEY,
+    user_id            INTEGER NOT NULL,
+    name               TEXT    NOT NULL,
+    type               TEXT    NOT NULL,
+    parent_id          TEXT,
+    root_category_id   TEXT,
+    icon               TEXT,
+    auto_repeat_budget INTEGER DEFAULT 0
+  );
+
+  CREATE TABLE bill_new (
+    id           TEXT    NOT NULL PRIMARY KEY,
+    user_id      INTEGER NOT NULL,
+    category_id  TEXT,
+    from_acc_id  INTEGER NOT NULL DEFAULT 0,
+    amount_paise INTEGER NOT NULL,
+    type         TEXT    NOT NULL,
+    date         TEXT    NOT NULL,
+    title        TEXT    NOT NULL,
+    description  TEXT,
+    billstatus   TEXT    NOT NULL DEFAULT 'C',
+    smssender    TEXT,
+    deduphash    TEXT
+  );
+
+  CREATE TABLE budget_new (
+    id          TEXT    NOT NULL PRIMARY KEY,
+    user_id     INTEGER NOT NULL,
+    category_id TEXT    NOT NULL,
+    year        INTEGER NOT NULL,
+    month       INTEGER,
+    type        TEXT    NOT NULL,
+    limit_paise INTEGER NOT NULL,
+    used_paise  INTEGER DEFAULT 0
+  );
+
+  CREATE TABLE bill_docurl_new (
+    id      INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
+    bill_id TEXT    NOT NULL,
+    url     TEXT    NOT NULL
+  );
+
+  CREATE TABLE sync_outbox (
+    seq        INTEGER PRIMARY KEY AUTOINCREMENT,
+    op_id      TEXT    NOT NULL UNIQUE,
+    user_id    INTEGER NOT NULL,
+    entity     TEXT    NOT NULL,
+    record_id  TEXT    NOT NULL,
+    op         TEXT    NOT NULL,
+    data       TEXT,
+    sent       INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT    NOT NULL
+  );
+
+  CREATE TABLE sync_state (
+    key   TEXT NOT NULL PRIMARY KEY,
+    value TEXT NOT NULL
+  );
+`;
diff --git a/tests/uuidMigration/copyData.test.ts b/tests/uuidMigration/copyData.test.ts
new file mode 100644
index 0000000..2cbaf91
--- /dev/null
+++ b/tests/uuidMigration/copyData.test.ts
@@ -0,0 +1,170 @@
+import { describe, it, expect } from "vitest";
+import { createOldDb, insertSampleData, fakeIdGenerator, wrap } from "./oldDb";
+import { createNewTables, copyAllData } from "@/data/database/uuidMigration/copyData";
+
+/**
+ * 2.1c — new tables + id map + copy rows (links rewritten, money in paise) + outbox rows.
+ * Old tables are only read here; swap happens in 2.1d.
+ */
+
+const NOW = "2026-10-25 10:00:00";
+
+function migrate(options: { withAtt?: boolean; withLegacyCategoryColumns?: boolean } = {}) {
+  const raw = createOldDb(options);
+  if (options.withLegacyCategoryColumns === false) {
+    raw.exec(`
+      INSERT INTO category (id, name, userid, parentid, typeofcategory, icon) VALUES (1, 'Food', 5, NULL, 'E', NULL);
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title) VALUES (42, 10, 1, 0, 5, '2026-10-18 10:30:00', 'E', 'Tea');
+    `);
+  } else {
+    insertSampleData(raw, options.withAtt ?? true);
+  }
+  const db = wrap(raw);
+  createNewTables(db);
+  const result = copyAllData(db, fakeIdGenerator(), NOW);
+  return { raw, db, result };
+}
+
+describe("id map", () => {
+  it("gives every old row a new id, in old-id order per table", () => {
+    const { result } = migrate();
+    expect(result.idMaps.category.get(1)).toBe("id-0001");
+    expect(result.idMaps.category.get(3)).toBe("id-0002");
+    expect(result.idMaps.category.get(7)).toBe("id-0003");
+    expect(result.idMaps.category.size).toBe(3);
+    expect(result.idMaps.budget.size).toBe(1);
+    expect(result.idMaps.bill.size).toBe(4);
+  });
+});
+
+describe("category_new", () => {
+  it("copies rows with new ids and rewritten parent / root links", () => {
+    const { db, result } = migrate();
+    const tea = db.all<any>("SELECT * FROM category_new WHERE name = 'Tea'")[0];
+    expect(tea.id).toBe(result.idMaps.category.get(7));
+    expect(tea.parent_id).toBe(result.idMaps.category.get(1));
+    expect(tea.root_category_id).toBe(result.idMaps.category.get(1));
+    expect(tea.user_id).toBe(5);
+    expect(tea.type).toBe("E");
+    expect(tea.auto_repeat_budget).toBe(0);
+    const food = db.all<any>("SELECT * FROM category_new WHERE name = 'Food'")[0];
+    expect(food.parent_id).toBeNull();
+    expect(food.icon).toBe("food.png");
+    expect(food.auto_repeat_budget).toBe(1);
+  });
+
+  it("works when legacy category columns are missing on the phone", () => {
+    const { db } = migrate({ withLegacyCategoryColumns: false });
+    const food = db.all<any>("SELECT * FROM category_new")[0];
+    expect(food.root_category_id).toBeNull();
+    expect(food.auto_repeat_budget).toBe(0);
+  });
+});
+
+describe("bill_new", () => {
+  it("money becomes paise and category link is rewritten", () => {
+    const { db, result } = migrate();
+    const tea = db.all<any>("SELECT * FROM bill_new WHERE title = 'Tea'")[0];
+    expect(tea.id).toBe(result.idMaps.bill.get(42));
+    expect(tea.amount_paise).toBe(45050);
+    expect(tea.category_id).toBe(result.idMaps.category.get(7));
+    expect(tea.type).toBe("E");
+    expect(tea.date).toBe("2026-10-18 10:30:00");
+    expect(tea.billstatus).toBe("C");
+  });
+
+  it("ATT draft keeps status / sender / hash, category 0 becomes NULL", () => {
+    const { db } = migrate();
+    const draft = db.all<any>("SELECT * FROM bill_new WHERE title = 'SMS draft'")[0];
+    expect(draft.category_id).toBeNull();
+    expect(draft.billstatus).toBe("D");
+    expect(draft.smssender).toBe("VK-HDFCBK");
+    expect(draft.deduphash).toBe("hash1");
+  });
+
+  it("bill pointing to a category that no longer exists gets category NULL", () => {
+    const { db } = migrate();
+    const lost = db.all<any>("SELECT * FROM bill_new WHERE title = 'Lost category'")[0];
+    expect(lost.category_id).toBeNull();
+  });
+
+  it("phone without ATT columns: status 'C', no sender / hash", () => {
+    const { db } = migrate({ withAtt: false });
+    const rows = db.all<any>("SELECT billstatus, smssender, deduphash FROM bill_new");
+    expect(rows.length).toBe(3);
+    for (const row of rows) {
+      expect(row.billstatus).toBe("C");
+      expect(row.smssender).toBeNull();
+      expect(row.deduphash).toBeNull();
+    }
+  });
+});
+
+describe("budget_new and bill_docurl_new", () => {
+  it("budget money in paise, category link rewritten", () => {
+    const { db, result } = migrate();
+    const budget = db.all<any>("SELECT * FROM budget_new")[0];
+    expect(budget.id).toBe(result.idMaps.budget.get(5));
+    expect(budget.category_id).toBe(result.idMaps.category.get(1));
+    expect(budget.limit_paise).toBe(100000);
+    expect(budget.used_paise).toBe(20050);
+    expect(budget.month).toBe(10);
+  });
+
+  it("attachment follows its bill's new id", () => {
+    const { db, result } = migrate();
+    const doc = db.all<any>("SELECT * FROM bill_docurl_new")[0];
+    expect(doc.bill_id).toBe(result.idMaps.bill.get(42));
+    expect(doc.url).toBe("file://receipt.jpg");
+  });
+});
+
+describe("old tables", () => {
+  it("are not changed", () => {
+    const { db } = migrate();
+    expect(db.all<any>("SELECT COUNT(*) AS n FROM bill")[0].n).toBe(4);
+    expect(db.all<any>("SELECT amount FROM bill WHERE id = 42")[0].amount).toBe(450.5);
+  });
+});
+
+describe("sync_outbox", () => {
+  it("one INSERT per category, budget and non-draft bill, in that order", () => {
+    const { db } = migrate();
+    const ops = db.all<any>("SELECT entity, op FROM sync_outbox ORDER BY seq");
+    expect(ops.map((o) => o.entity)).toEqual(["category", "category", "category", "budget", "bill", "bill", "bill"]);
+    expect(ops.every((o) => o.op === "INSERT")).toBe(true);
+  });
+
+  it("drafts are not in the outbox", () => {
+    const { db, result } = migrate();
+    const draftId = result.idMaps.bill.get(43);
+    expect(db.all<any>("SELECT * FROM sync_outbox WHERE record_id = ?", [draftId]).length).toBe(0);
+  });
+
+  it("data holds only wire columns, user_id is the row's user, op_id unique", () => {
+    const { db, result } = migrate();
+    const teaId = result.idMaps.bill.get(42);
+    const op = db.all<any>("SELECT * FROM sync_outbox WHERE record_id = ?", [teaId])[0];
+    expect(JSON.parse(op.data)).toEqual({
+      id: teaId,
+      category_id: result.idMaps.category.get(7),
+      amount_paise: 45050,
+      type: "E",
+      date: "2026-10-18 10:30:00",
+      title: "Tea",
+      description: null,
+    });
+    expect(op.user_id).toBe(5);
+    expect(op.sent).toBe(0);
+    expect(op.created_at).toBe(NOW);
+    const salary = db.all<any>("SELECT user_id FROM sync_outbox WHERE record_id = ?", [result.idMaps.category.get(3)])[0];
+    expect(salary.user_id).toBe(6);
+    const opIds = db.all<any>("SELECT op_id FROM sync_outbox").map((o) => o.op_id);
+    expect(new Set(opIds).size).toBe(opIds.length);
+  });
+
+  it("sync_state exists and is empty", () => {
+    const { db } = migrate();
+    expect(db.all<any>("SELECT * FROM sync_state").length).toBe(0);
+  });
+});
