+import Database from "better-sqlite3";
+import { MigrationDb } from "@/data/database/uuidMigration/migrationDb";
+
+/**
+ * Test helpers: an OLD-shape phone database (integer ids, rupee amounts) in memory,
+ * wrapped in the same MigrationDb interface the app uses.
+ */
+
+export function wrap(db: Database.Database): MigrationDb {
+  return {
+    exec(sql: string) {
+      db.exec(sql);
+    },
+    run(sql: string, params: unknown[] = []) {
+      db.prepare(sql).run(...(params as never[]));
+    },
+    all<T>(sql: string, params: unknown[] = []): T[] {
+      return db.prepare(sql).all(...(params as never[])) as T[];
+    },
+  };
+}
+
+// old schema as created by the server migrations (+ ATT columns when withAtt)
+export function createOldDb(options: { withAtt?: boolean; withLegacyCategoryColumns?: boolean } = {}) {
+  const withAtt = options.withAtt ?? true;
+  const withLegacy = options.withLegacyCategoryColumns ?? true;
+  const db = new Database(":memory:");
+
+  db.exec(`
+    CREATE TABLE "category" (
+      "id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
+      "name" TEXT NOT NULL,
+      "userid" INTEGER NOT NULL,
+      ${withLegacy ? `"rootcategoryid" INTEGER,` : ""}
+      "parentid" INTEGER,
+      "typeofcategory" TEXT NOT NULL,
+      "icon" TEXT
+      ${withLegacy ? `, "autorepeatbudget" BOOLEAN DEFAULT false` : ""}
+    );
+    CREATE TABLE "bill" (
+      "id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
+      "amount" INTEGER NOT NULL,
+      "toaccid" INTEGER NOT NULL,
+      "fromaccid" INTEGER NOT NULL,
+      "userid" INTEGER NOT NULL,
+      "date" DATETIME NOT NULL,
+      "typeofbill" TEXT NOT NULL,
+      "title" TEXT NOT NULL,
+      "description" TEXT
+    );
+    CREATE TABLE "budget" (
+      "id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
+      "year" INTEGER NOT NULL,
+      "month" INTEGER,
+      "userid" INTEGER NOT NULL,
+      "categoryid" INTEGER NOT NULL,
+      "initialbudget" INTEGER NOT NULL,
+      "usedamount" INTEGER DEFAULT 0,
+      "type" TEXT NOT NULL
+    );
+    CREATE TABLE "bill_docurl" (
+      "id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
+      "billid" INTEGER NOT NULL,
+      "url" TEXT NOT NULL
+    );
+  `);
+
+  if (withAtt) {
+    db.exec(`
+      ALTER TABLE bill ADD COLUMN billstatus TEXT NOT NULL DEFAULT 'C';
+      ALTER TABLE bill ADD COLUMN smssender TEXT;
+      ALTER TABLE bill ADD COLUMN deduphash TEXT;
+    `);
+  }
+  return db;
+}
+
+// sample data: user 5 (main) and user 6 (second account on same phone)
+export function insertSampleData(db: Database.Database, withAtt = true) {
+  db.exec(`
+    INSERT INTO category (id, name, userid, rootcategoryid, parentid, typeofcategory, icon, autorepeatbudget) VALUES
+      (1, 'Food', 5, NULL, NULL, 'E', 'food.png', 1),
+      (7, 'Tea', 5, 1, 1, 'E', NULL, 0),
+      (3, 'Salary', 6, NULL, NULL, 'I', NULL, 0);
+    INSERT INTO budget (id, year, month, userid, categoryid, initialbudget, usedamount, type) VALUES
+      (5, 2026, 10, 5, 1, 1000, 200.5, 'M');
+  `);
+  db.exec(`
+    INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title, description) VALUES
+      (42, 450.5, 7, 0, 5, '2026-10-18 10:30:00', 'E', 'Tea', NULL),
+      (44, 99, 99, 0, 5, '2026-10-18 11:00:00', 'E', 'Lost category', 'x'),
+      (45, 50000, 3, 0, 6, '2026-10-01 09:00:00', 'I', 'Pay', NULL);
+    INSERT INTO bill_docurl (id, billid, url) VALUES (1, 42, 'file://receipt.jpg');
+  `);
+  if (withAtt) {
+    db.exec(`
+      INSERT INTO bill (id, amount, toaccid, fromaccid, userid, date, typeofbill, title, description, billstatus, smssender, deduphash)
+      VALUES (43, 120, 0, 0, 5, '2026-10-18 12:00:00', 'E', 'SMS draft', NULL, 'D', 'VK-HDFCBK', 'hash1');
+    `);
