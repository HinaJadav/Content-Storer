@@ -0,0 +1,198 @@
+import { MigrationDb } from "./migrationDb";
+import { NEW_TABLES_SQL } from "./newSchema";
+
+/**
+ * UUID migration — copy step (2.1c).
+ * Reads the OLD tables (integer ids, rupee amounts), writes the *_new tables:
+ * - every row gets a new id, given in old-id order (keeps sort order)
+ * - links (parentid, rootcategoryid, toaccid, categoryid, billid) point to the new ids
+ * - money -> whole paise
+ * - one INSERT op per category / budget / non-draft bill in sync_outbox, so the
+ *   first sync uploads everything (P2-D1). ATT drafts never go to the outbox.
+ * Old tables are only read. Must run inside the migration transaction.
+ */
+
+export interface IdMaps {
+  category: Map<number, string>;
+  budget: Map<number, string>;
+  bill: Map<number, string>;
+}
+
+export interface CopyResult {
+  idMaps: IdMaps;
+}
+
+// creates category_new, bill_new, budget_new, bill_docurl_new, sync_outbox, sync_state
+export function createNewTables(db: MigrationDb): void {
+  db.exec(NEW_TABLES_SQL);
+}
+
+// rupees (may hold decimals) -> whole paise
+function toPaise(amount: number | null): number {
+  if (amount === null || amount === undefined) {
+    return 0;
+  }
+  return Math.round(Number(amount) * 100);
+}
+
+// old link id -> new id; 0, null or a row that no longer exists -> null
+function mapLink(map: Map<number, string>, oldId: number | null): string | null {
+  if (oldId === null || oldId === undefined || oldId === 0) {
+    return null;
+  }
+  const newId = map.get(oldId);
+  if (newId === undefined) {
+    return null;
+  }
+  return newId;
+}
+
+// column names of a table on this phone (some phones miss ATT / legacy columns)
+function columnsOf(db: MigrationDb, table: string): string[] {
+  const rows = db.all<{ name: string }>(`PRAGMA table_info(${table})`);
+  return rows.map((row) => row.name);
+}
+
+// new id for every old row, in old-id order
+function buildIdMap(db: MigrationDb, table: string, newId: () => string): Map<number, string> {
+  const map = new Map<number, string>();
+  const rows = db.all<{ id: number }>(`SELECT id FROM ${table} ORDER BY id`);
+  for (const row of rows) {
+    map.set(row.id, newId());
+  }
+  return map;
+}
+
+function addOutboxInsert(
+  db: MigrationDb,
+  newId: () => string,
+  now: string,
+  userId: number,
+  entity: string,
+  recordId: string,
+  data: Record<string, unknown>,
+): void {
+  db.run(
+    `INSERT INTO sync_outbox (op_id, user_id, entity, record_id, op, data, sent, created_at)
+     VALUES (?, ?, ?, ?, 'INSERT', ?, 0, ?)`,
+    [newId(), userId, entity, recordId, JSON.stringify(data), now],
+  );
+}
+
+function copyCategories(db: MigrationDb, maps: IdMaps, newId: () => string, now: string): void {
+  const columns = columnsOf(db, "category");
+  const hasRoot = columns.includes("rootcategoryid");
+  const hasAutoRepeat = columns.includes("autorepeatbudget");
+
+  const rows = db.all<any>(`SELECT * FROM category ORDER BY id`);
+  for (const row of rows) {
+    const id = maps.category.get(row.id) as string;
+    const parentId = mapLink(maps.category, row.parentid);
+    const rootId = hasRoot ? mapLink(maps.category, row.rootcategoryid) : null;
+    const autoRepeat = hasAutoRepeat && row.autorepeatbudget ? 1 : 0;
+
+    db.run(
+      `INSERT INTO category_new (id, user_id, name, type, parent_id, root_category_id, icon, auto_repeat_budget)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+      [id, row.userid, row.name, row.typeofcategory, parentId, rootId, row.icon, autoRepeat],
+    );
+    addOutboxInsert(db, newId, now, row.userid, "category", id, {
+      id: id,
+      name: row.name,
+      type: row.typeofcategory,
+      parent_id: parentId,
+      icon: row.icon,
+    });
+  }
+}
+
+function copyBudgets(db: MigrationDb, maps: IdMaps, newId: () => string, now: string): void {
+  const rows = db.all<any>(`SELECT * FROM budget ORDER BY id`);
+  for (const row of rows) {
+    const id = maps.budget.get(row.id) as string;
+    const categoryId = mapLink(maps.category, row.categoryid);
+    const limitPaise = toPaise(row.initialbudget);
+
+    db.run(
+      `INSERT INTO budget_new (id, user_id, category_id, year, month, type, limit_paise, used_paise)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+      [id, row.userid, categoryId, row.year, row.month, row.type, limitPaise, toPaise(row.usedamount)],
+    );
+    addOutboxInsert(db, newId, now, row.userid, "budget", id, {
+      id: id,
+      category_id: categoryId,
+      year: row.year,
+      month: row.month,
+      type: row.type,
+      limit_paise: limitPaise,
+    });
+  }
+}
+
+function copyBills(db: MigrationDb, maps: IdMaps, newId: () => string, now: string): void {
+  const hasAtt = columnsOf(db, "bill").includes("billstatus");
+
+  const rows = db.all<any>(`SELECT * FROM bill ORDER BY id`);
+  for (const row of rows) {
+    const id = maps.bill.get(row.id) as string;
+    const categoryId = mapLink(maps.category, row.toaccid);
+    const amountPaise = toPaise(row.amount);
+    const status = hasAtt ? row.billstatus : "C";
+    const sender = hasAtt ? row.smssender : null;
+    const hash = hasAtt ? row.deduphash : null;
+
+    db.run(
+      `INSERT INTO bill_new (id, user_id, category_id, from_acc_id, amount_paise, type, date, title, description, billstatus, smssender, deduphash)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      [id, row.userid, categoryId, row.fromaccid ?? 0, amountPaise, row.typeofbill, row.date, row.title, row.description, status, sender, hash],
+    );
+
+    // SMS drafts stay on the phone until the user confirms them
+    if (status === "D") {
+      continue;
+    }
+    addOutboxInsert(db, newId, now, row.userid, "bill", id, {
+      id: id,
+      category_id: categoryId,
+      amount_paise: amountPaise,
+      type: row.typeofbill,
+      date: row.date,
+      title: row.title,
+      description: row.description,
+    });
+  }
+}
+
+function copyDocUrls(db: MigrationDb, maps: IdMaps): void {
+  const rows = db.all<any>(`SELECT * FROM bill_docurl ORDER BY id`);
+  for (const row of rows) {
+    const billId = mapLink(maps.bill, row.billid);
+    // attachment of a bill that no longer exists: nothing to point to
+    if (billId === null) {
+      continue;
+    }
+    db.run(`INSERT INTO bill_docurl_new (bill_id, url) VALUES (?, ?)`, [billId, row.url]);
+  }
+}
+
+/**
+ * Copies all old rows into the *_new tables and fills sync_outbox.
+ * Order: categories, budgets, bills (parents before children for the first sync).
+ *
+ * @param newId - creates one new id (uuid v7 in the app, predictable ids in tests)
+ * @param now - created_at for outbox rows ("YYYY-MM-DD HH:MM:SS")
+ */
+export function copyAllData(db: MigrationDb, newId: () => string, now: string): CopyResult {
+  const maps: IdMaps = {
+    category: buildIdMap(db, "category", newId),
+    budget: buildIdMap(db, "budget", newId),
+    bill: buildIdMap(db, "bill", newId),
+  };
+
+  copyCategories(db, maps, newId, now);
+  copyBudgets(db, maps, newId, now);
+  copyBills(db, maps, newId, now);
+  copyDocUrls(db, maps);
+
+  return { idMaps: maps };
+}
