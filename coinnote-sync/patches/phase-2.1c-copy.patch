new file mode 100644
index 0000000..84278f3
--- /dev/null
+++ b/data/database/uuidMigration/migrationDb.ts
@@ -0,0 +1,13 @@
+/**
+ * Minimal database interface used by the UUID migration.
+ * The app passes the expo-sqlite singleton through a small adapter; tests pass
+ * better-sqlite3. Keeping the migration on this interface lets it be tested in Node.
+ */
+export interface MigrationDb {
+  // run one or more SQL statements, no parameters, no result
+  exec(sql: string): void;
+  // run one statement with parameters (INSERT / UPDATE / DELETE)
+  run(sql: string, params?: unknown[]): void;
+  // run a SELECT and return all rows
+  all<T>(sql: string, params?: unknown[]): T[];
+}
