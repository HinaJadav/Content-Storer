+++ b/data/database/uuidMigration/expoMigrationDb.ts
@@ -0,0 +1,20 @@
+import { SQLiteBindValue, SQLiteDatabase } from "expo-sqlite";
+import { MigrationDb } from "./migrationDb";
+
+/**
+ * Adapter: expo-sqlite database -> MigrationDb, so the UUID migration runs on the phone.
+ * Phone-only (expo-sqlite is native), so it is not part of the Node tests.
+ */
+export function expoMigrationDb(db: SQLiteDatabase): MigrationDb {
+  return {
+    exec(sql: string) {
+      db.execSync(sql);
+    },
+    run(sql: string, params: unknown[] = []) {
+      db.runSync(sql, params as SQLiteBindValue[]);
+    },
+    all<T>(sql: string, params: unknown[] = []): T[] {
+      return db.getAllSync<T>(sql, params as SQLiteBindValue[]);
+    },
+  };
+}
