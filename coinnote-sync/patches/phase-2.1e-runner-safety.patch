@@ -0,0 +1,56 @@
+import { ResponseParams } from "@/interfaces/interface";
+import { response } from "@/util/response";
+import { v7 as uuidv7 } from "uuid";
+import { migrateToUuid } from "./migrateToUuid";
+import { MigrationDb } from "./migrationDb";
+import { UUID_MIGRATION_USER_VERSION } from "./swapTables";
+
+/**
+ * UUID migration — runner (2.1e).
+ * 1. already migrated (PRAGMA user_version >= 1) -> skip
+ * 2. safety copy of the whole DB (escape hatch, Q3) -> if it fails, do NOT migrate
+ * 3. migrateToUuid (one transaction, rollback on any problem)
+ *
+ * Safe to call on every launch. NOT wired into the app yet (Phase 2 last step).
+ */
+
+export interface UuidMigrationDeps {
+  // copies the DB before migrating (phone: safetyCopy.makeSafetyCopy)
+  makeSafetyCopy: () => ResponseParams<null>;
+  // new id for every row / outbox op (default: lowercase uuid v7)
+  newId?: () => string;
+  // current local time "YYYY-MM-DD HH:MM:SS" (default: device clock)
+  now?: () => string;
+}
+
+// device local time as "YYYY-MM-DD HH:MM:SS"
+function localNow(): string {
+  const d = new Date();
+  const pad = (value: number) => String(value).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
+}
+
+function currentUserVersion(db: MigrationDb): number {
+  const rows = db.all<{ user_version: number }>("PRAGMA user_version");
+  return rows.length > 0 ? Number(rows[0].user_version) : 0;
+}
+
+export function runUuidMigration(db: MigrationDb, deps: UuidMigrationDeps): ResponseParams<null> {
+  try {
+    if (currentUserVersion(db) >= UUID_MIGRATION_USER_VERSION) {
+      return response(null, false, "", 200, { skipped: true });
+    }
+
+    const copy = deps.makeSafetyCopy();
+    if (copy.IsError) {
+      return response(null, true, copy.ErrorMessage, copy.StatusCode);
+    }
+
+    const newId = deps.newId ?? (() => uuidv7());
+    const now = deps.now ?? localNow;
+    return migrateToUuid(db, newId, now());
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return response(null, true, "uuid migration failed: " + message, 500);
+  }
+}
diff --git a/data/database/uuidMigration/safetyCopy.ts b/data/database/uuidMigration/safetyCopy.ts
new file mode 100644
index 0000000..911327a
--- /dev/null
+++ b/data/database/uuidMigration/safetyCopy.ts
@@ -0,0 +1,53 @@
+import { ResponseParams } from "@/interfaces/interface";
+import { response } from "@/util/response";
+import * as SQLite from "expo-sqlite";
+import { db } from "../db.config";
+
+/**
+ * Pre-migration safety copy (escape hatch, Q3).
+ * - makeSafetyCopy: full copy of coinnote.db into coinnote_pre_uuid.db before the UUID migration
+ * - restoreSafetyCopy: copies it back over the live DB (user_version back to 0, so the
+ *   migration runs again on next launch, e.g. after a fixed build)
+ * Uses expo-sqlite's own backupDatabaseSync. The copy is a separate file, opened only
+ * for the copy and closed right after (the app's singleton `db` stays the only live DB).
+ * Kept for 2 releases, removed in Phase 6. Phone-only, not part of the Node tests.
+ */
+
+export const SAFETY_COPY_NAME = "coinnote_pre_uuid.db";
+
+export function makeSafetyCopy(): ResponseParams<null> {
+  try {
+    const copyDb = SQLite.openDatabaseSync(SAFETY_COPY_NAME);
+    try {
+      SQLite.backupDatabaseSync({ sourceDatabase: db, destDatabase: copyDb });
+    } finally {
+      copyDb.closeSync();
+    }
+    return response(null, false, "", 200);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return response(null, true, "safety copy failed: " + message, 500);
+  }
+}
+
+export function restoreSafetyCopy(): ResponseParams<null> {
+  try {
+    const copyDb = SQLite.openDatabaseSync(SAFETY_COPY_NAME);
+    try {
+      // opening a missing file creates an empty DB: never restore an empty copy over real data
+      const tables = copyDb.getAllSync<{ n: number }>(
+        "SELECT COUNT(*) AS n FROM sqlite_master WHERE type = 'table' AND name = 'bill'",
+      );
+      if (tables.length === 0 || Number(tables[0].n) === 0) {
+        return response(null, true, "no safety copy found", 404);
+      }
+      SQLite.backupDatabaseSync({ sourceDatabase: copyDb, destDatabase: db });
+    } finally {
+      copyDb.closeSync();
+    }
+    return response(null, false, "", 200);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return response(null, true, "restore failed: " + message, 500);
+  }
+}
diff --git a/tests/uuidMigration/runUuidMigration.test.ts b/tests/uuidMigration/runUuidMigration.test.ts
new file mode 100644
index 0000000..6945582
--- /dev/null
+++ b/tests/uuidMigration/runUuidMigration.test.ts
@@ -0,0 +1,82 @@
+import { describe, it, expect, vi } from "vitest";
+import { createOldDb, insertSampleData, fakeIdGenerator, wrap } from "./oldDb";
+import { runUuidMigration } from "@/data/database/uuidMigration/runUuidMigration";
+import { response } from "@/util/response";
+
+/**
+ * 2.1e — runner: skip if already migrated -> safety copy -> migrateToUuid.
+ * Safety copy is passed in (phone-only code), so the runner is tested in Node.
+ */
+
+const NOW = () => "2026-10-25 10:00:00";
+const copyOk = () => response(null, false, "", 200);
+
+function oldPhone() {
+  const raw = createOldDb();
+  insertSampleData(raw);
+  return raw;
+}
+
+function userVersion(raw: ReturnType<typeof createOldDb>): number {
+  return raw.pragma("user_version", { simple: true }) as number;
+}
+
+describe("runUuidMigration", () => {
+  it("old phone: makes the safety copy, migrates, user_version 1", () => {
+    const raw = oldPhone();
+    const makeSafetyCopy = vi.fn(copyOk);
+    const result = runUuidMigration(wrap(raw), { makeSafetyCopy: makeSafetyCopy, newId: fakeIdGenerator(), now: NOW });
+    expect(result.IsError).toBe(false);
+    expect(makeSafetyCopy).toHaveBeenCalledTimes(1);
+    expect(userVersion(raw)).toBe(1);
+  });
+
+  it("already migrated: skips, no copy, nothing changes", () => {
+    const raw = oldPhone();
+    runUuidMigration(wrap(raw), { makeSafetyCopy: copyOk, newId: fakeIdGenerator(), now: NOW });
+    const makeSafetyCopy = vi.fn(copyOk);
+    const result = runUuidMigration(wrap(raw), { makeSafetyCopy: makeSafetyCopy, newId: fakeIdGenerator(), now: NOW });
+    expect(result.IsError).toBe(false);
+    expect(result.Other?.skipped).toBe(true);
+    expect(makeSafetyCopy).not.toHaveBeenCalled();
+    expect(userVersion(raw)).toBe(1);
+  });
+
+  it("safety copy fails: no migration, error returned, old tables untouched", () => {
+    const raw = oldPhone();
+    const copyFails = () => response(null, true, "safety copy failed: disk full", 500);
+    const result = runUuidMigration(wrap(raw), { makeSafetyCopy: copyFails, newId: fakeIdGenerator(), now: NOW });
+    expect(result.IsError).toBe(true);
+    expect(result.ErrorMessage).toContain("disk full");
+    expect(userVersion(raw)).toBe(0);
+    const cols = (raw.prepare("PRAGMA table_info(bill)").all() as { name: string }[]).map((c) => c.name);
+    expect(cols).toContain("amount");
+  });
+
+  it("migration error is passed through, phone stays old (retry next launch)", () => {
+    const raw = oldPhone();
+    const brokenId = () => {
+      throw new Error("boom");
+    };
+    const result = runUuidMigration(wrap(raw), { makeSafetyCopy: copyOk, newId: brokenId, now: NOW });
+    expect(result.IsError).toBe(true);
+    expect(result.ErrorMessage).toContain("boom");
+    expect(userVersion(raw)).toBe(0);
+  });
+
+  it("uses now() for outbox created_at", () => {
+    const raw = oldPhone();
+    runUuidMigration(wrap(raw), { makeSafetyCopy: copyOk, newId: fakeIdGenerator(), now: NOW });
+    const row = raw.prepare("SELECT created_at FROM sync_outbox LIMIT 1").get() as { created_at: string };
+    expect(row.created_at).toBe("2026-10-25 10:00:00");
+  });
+
+  it("default id generator gives lowercase uuid v7", () => {
+    const raw = oldPhone();
+    runUuidMigration(wrap(raw), { makeSafetyCopy: copyOk });
+    const row = raw.prepare("SELECT id FROM category LIMIT 1").get() as { id: string };
+    expect(row.id).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
+    const created = (raw.prepare("SELECT created_at FROM sync_outbox LIMIT 1").get() as { created_at: string }).created_at;
+    expect(created).toMatch(/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/);
+  });
+});
