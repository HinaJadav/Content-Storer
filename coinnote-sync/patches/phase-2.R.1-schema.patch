diff --git a/tests/schema.test.ts b/tests/schema.test.ts
new file mode 100644
index 0000000..ccd6735
--- /dev/null
+++ b/tests/schema.test.ts
@@ -0,0 +1,71 @@
+import { describe, it, expect } from "vitest";
+import { Prisma } from "@prisma/client";
+
+/**
+ * 2.R step 1 — schema rework checks.
+ * Reads Prisma's own model info (generated from schema.prisma), no database needed.
+ */
+
+function model(name: string) {
+    const found = Prisma.dmmf.datamodel.models.find((m) => m.name === name);
+    if (!found) {
+        throw new Error(`model ${name} not found`);
+    }
+    return found;
+}
+
+function fieldNames(name: string): string[] {
+    return model(name).fields.map((f) => f.name);
+}
+
+describe("users", () => {
+    it("has sync_version (BigInt, default 0)", () => {
+        const field = model("users").fields.find((f) => f.name === "sync_version");
+        expect(field).toBeDefined();
+        expect(field?.type).toBe("BigInt");
+        expect(field?.isRequired).toBe(true);
+        expect(String(field?.default)).toBe("0"); // Prisma reports BigInt defaults as text
+    });
+
+    it("no longer has current_seq or cloud_state", () => {
+        expect(fieldNames("users")).not.toContain("current_seq");
+        expect(fieldNames("users")).not.toContain("cloud_state");
+    });
+});
+
+describe("category / bill / budget", () => {
+    for (const name of ["category", "bill", "budget"]) {
+        it(`${name}: updated_seq and last_op_id removed`, () => {
+            expect(fieldNames(name)).not.toContain("updated_seq");
+            expect(fieldNames(name)).not.toContain("last_op_id");
+        });
+
+        it(`${name}: primary key is still (user_id, id)`, () => {
+            expect(model(name).primaryKey?.fields).toEqual(["user_id", "id"]);
+        });
+    }
+});
+
+describe("change_log", () => {
+    it("has a required op_id", () => {
+        const field = model("change_log").fields.find((f) => f.name === "op_id");
+        expect(field).toBeDefined();
+        expect(field?.type).toBe("String");
+        expect(field?.isRequired).toBe(true);
+    });
+
+    it("op_id is unique per user", () => {
+        expect(model("change_log").uniqueFields).toContainEqual(["user_id", "op_id"]);
+    });
+
+    it("primary key is still (user_id, seq)", () => {
+        expect(model("change_log").primaryKey?.fields).toEqual(["user_id", "seq"]);
+    });
+
+    it("keeps entity, row_id, op, origin_device, created_at", () => {
+        const names = fieldNames("change_log");
+        for (const col of ["entity", "row_id", "op", "origin_device", "created_at"]) {
+            expect(names).toContain(col);
+        }
+    });
+});
