diff --git a/tests/sync/outboxRepo.test.ts b/tests/sync/outboxRepo.test.ts
new file mode 100644
index 0000000..402a539
--- /dev/null
+++ b/tests/sync/outboxRepo.test.ts
@@ -0,0 +1,149 @@
+import { describe, it, expect } from "vitest";
+import Database from "better-sqlite3";
+import { wrap } from "../uuidMigration/oldDb";
+import { NEW_TABLES_SQL } from "@/data/database/uuidMigration/newSchema";
+import { addOutboxOp } from "@/data/database/sync/outboxRepo";
+
+/**
+ * 2.2b — local operation log (P2-D1). One op per record while unsent (collapse rules).
+ * A sent op (sent = 1, waiting for the server) is never changed.
+ */
+
+const NOW = () => "2026-10-25 10:00:00";
+
+function setup() {
+  const raw = new Database(":memory:");
+  raw.exec(NEW_TABLES_SQL); // includes sync_outbox
+  let n = 0;
+  const newId = () => "op-" + ++n;
+  const db = wrap(raw);
+  const add = (op: "INSERT" | "UPDATE" | "DELETE", recordId: string, data: Record<string, unknown> | null) =>
+    addOutboxOp(db, { userId: 5, entity: "bill", recordId: recordId, op: op, data: data }, { newId: newId, now: NOW });
+  const rows = () => raw.prepare("SELECT * FROM sync_outbox ORDER BY seq").all() as any[];
+  return { raw, db, add, rows };
+}
+
+describe("addOutboxOp — new record", () => {
+  it("adds one row with op_id, user, entity, data as JSON, sent 0", () => {
+    const { add, rows } = setup();
+    const result = add("INSERT", "b1", { id: "b1", amount_paise: 4500 });
+    expect(result.IsError).toBe(false);
+    const all = rows();
+    expect(all.length).toBe(1);
+    expect(all[0]).toMatchObject({ op_id: "op-1", user_id: 5, entity: "bill", record_id: "b1", op: "INSERT", sent: 0, created_at: "2026-10-25 10:00:00" });
+    expect(JSON.parse(all[0].data)).toEqual({ id: "b1", amount_paise: 4500 });
+  });
+});
+
+describe("addOutboxOp — collapse into the unsent op", () => {
+  it("INSERT + UPDATE -> one INSERT with the new data", () => {
+    const { add, rows } = setup();
+    add("INSERT", "b1", { id: "b1", amount_paise: 4500 });
+    add("UPDATE", "b1", { id: "b1", amount_paise: 5000 });
+    const all = rows();
+    expect(all.length).toBe(1);
+    expect(all[0].op).toBe("INSERT");
+    expect(JSON.parse(all[0].data).amount_paise).toBe(5000);
+  });
+
+  it("INSERT + DELETE -> nothing left (server never had it)", () => {
+    const { add, rows } = setup();
+    add("INSERT", "b1", { id: "b1" });
+    add("DELETE", "b1", null);
+    expect(rows().length).toBe(0);
+  });
+
+  it("UPDATE + UPDATE -> one UPDATE with the latest data", () => {
+    const { add, rows } = setup();
+    add("UPDATE", "b1", { id: "b1", title: "Tea" });
+    add("UPDATE", "b1", { id: "b1", title: "Chai" });
+    const all = rows();
+    expect(all.length).toBe(1);
+    expect(all[0].op).toBe("UPDATE");
+    expect(JSON.parse(all[0].data).title).toBe("Chai");
+  });
+
+  it("UPDATE + DELETE -> one DELETE without data", () => {
+    const { add, rows } = setup();
+    add("UPDATE", "b1", { id: "b1", title: "Tea" });
+    add("DELETE", "b1", null);
+    const all = rows();
+    expect(all.length).toBe(1);
+    expect(all[0].op).toBe("DELETE");
+    expect(all[0].data).toBeNull();
+  });
+
+  it("collapsing keeps the first op's place in the queue and its op_id", () => {
+    const { add, rows } = setup();
+    add("INSERT", "b1", { id: "b1" });
+    add("INSERT", "b2", { id: "b2" });
+    add("UPDATE", "b1", { id: "b1", title: "x" });
+    const all = rows();
+    expect(all.map((r) => r.record_id)).toEqual(["b1", "b2"]);
+    expect(all[0].op_id).toBe("op-1");
+  });
+});
+
+describe("addOutboxOp — sent op is never changed", () => {
+  it("op in flight (sent = 1) + UPDATE -> new row, sent row untouched", () => {
+    const { raw, add, rows } = setup();
+    add("INSERT", "b1", { id: "b1", amount_paise: 4500 });
+    raw.exec("UPDATE sync_outbox SET sent = 1");
+    add("UPDATE", "b1", { id: "b1", amount_paise: 6000 });
+    const all = rows();
+    expect(all.length).toBe(2);
+    expect(all[0].sent).toBe(1);
+    expect(JSON.parse(all[0].data).amount_paise).toBe(4500);
+    expect(all[1]).toMatchObject({ op: "UPDATE", sent: 0 });
+  });
+
+  it("op in flight + DELETE -> new DELETE row", () => {
+    const { raw, add, rows } = setup();
+    add("INSERT", "b1", { id: "b1" });
+    raw.exec("UPDATE sync_outbox SET sent = 1");
+    add("DELETE", "b1", null);
+    expect(rows().map((r) => r.op)).toEqual(["INSERT", "DELETE"]);
+  });
+});
+
+describe("addOutboxOp — other records and invalid input", () => {
+  it("ops of different records don't affect each other", () => {
+    const { add, rows } = setup();
+    add("INSERT", "b1", { id: "b1" });
+    add("DELETE", "b2", null);
+    expect(rows().length).toBe(2);
+  });
+
+  it("same record id in another entity is a different record", () => {
+    const { db, rows } = setup();
+    addOutboxOp(db, { userId: 5, entity: "bill", recordId: "x", op: "INSERT", data: { id: "x" } }, { newId: () => "o1", now: NOW });
+    addOutboxOp(db, { userId: 5, entity: "budget", recordId: "x", op: "DELETE", data: null }, { newId: () => "o2", now: NOW });
+    expect(rows().length).toBe(2);
+  });
+
+  it("INSERT / UPDATE without data -> error, nothing written", () => {
+    const { add, rows } = setup();
+    const result = add("INSERT", "b1", null);
+    expect(result.IsError).toBe(true);
+    expect(result.StatusCode).toBe(400);
+    expect(rows().length).toBe(0);
+  });
+
+  it("DELETE with data -> error, nothing written", () => {
+    const { add, rows } = setup();
+    expect(add("DELETE", "b1", { id: "b1" }).IsError).toBe(true);
+    expect(rows().length).toBe(0);
+  });
+
+  it("unknown entity -> error", () => {
+    const { db } = setup();
+    const result = addOutboxOp(db, { userId: 5, entity: "users" as never, recordId: "x", op: "INSERT", data: { id: "x" } });
+    expect(result.IsError).toBe(true);
+  });
+
+  it("default op_id is a lowercase uuid v7", () => {
+    const { db, rows } = setup();
+    addOutboxOp(db, { userId: 5, entity: "bill", recordId: "x", op: "INSERT", data: { id: "x" } });
+    expect(rows()[0].op_id).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
+  });
+});
