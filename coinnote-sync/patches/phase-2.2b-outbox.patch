+++ b/data/database/sqlDb.ts
@@ -0,0 +1,13 @@
+/**
+ * Minimal database interface for new sync-related code (migration, outbox, defaults).
+ * The app passes the expo-sqlite singleton through an adapter
+ * (uuidMigration/expoMigrationDb.ts); tests pass better-sqlite3.
+ */
+export interface SqlDb {
+  // run one or more SQL statements, no parameters, no result
+  exec(sql: string): void;
+  // run one statement with parameters (INSERT / UPDATE / DELETE)
+  run(sql: string, params?: unknown[]): void;
+  // run a SELECT and return all rows
+  all<T>(sql: string, params?: unknown[]): T[];
+}
diff --git a/data/database/sync/outboxRepo.ts b/data/database/sync/outboxRepo.ts
new file mode 100644
index 0000000..6ba2c34
--- /dev/null
+++ b/data/database/sync/outboxRepo.ts
@@ -0,0 +1,122 @@
+import { ResponseParams } from "@/interfaces/interface";
+import { response } from "@/util/response";
+import { v7 as uuidv7 } from "uuid";
+import { SqlDb } from "../sqlDb";
+
+/**
+ * Local operation log (sync_outbox, decision P2-D1).
+ * Every add / edit / delete of a synced row writes one op here, in the SAME
+ * transaction as the real change (the caller opens the transaction).
+ *
+ * Collapse rules — only into an op that is not sent yet (sent = 0):
+ *   INSERT + UPDATE -> INSERT with new data
+ *   INSERT + DELETE -> both removed (server never had the row)
+ *   UPDATE + UPDATE -> UPDATE with new data
+ *   UPDATE + DELETE -> DELETE
+ * An op already sent (sent = 1, waiting for the server reply) is never changed:
+ * a new op is added instead.
+ */
+
+export type OutboxEntity = "category" | "budget" | "bill";
+export type OutboxOpType = "INSERT" | "UPDATE" | "DELETE";
+
+export interface NewOutboxOp {
+  userId: number;
+  entity: OutboxEntity;
+  recordId: string;
+  op: OutboxOpType;
+  // wire columns of the row (registry), null for DELETE
+  data: Record<string, unknown> | null;
+}
+
+export interface OutboxOptions {
+  // new op_id (default: lowercase uuid v7)
+  newId?: () => string;
+  // created_at "YYYY-MM-DD HH:MM:SS" (default: device clock)
+  now?: () => string;
+}
+
+const ENTITIES: string[] = ["category", "budget", "bill"];
+
+// device local time as "YYYY-MM-DD HH:MM:SS"
+function localNow(): string {
+  const d = new Date();
+  const pad = (value: number) => String(value).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
+}
+
+// input problems -> message, valid -> null
+function validate(input: NewOutboxOp): string | null {
+  if (!ENTITIES.includes(input.entity)) {
+    return "unknown entity: " + input.entity;
+  }
+  if (input.op === "DELETE" && input.data !== null) {
+    return "DELETE must not have data";
+  }
+  if (input.op !== "DELETE" && input.data === null) {
+    return input.op + " needs data";
+  }
+  return null;
+}
+
+function insertOp(db: SqlDb, input: NewOutboxOp, opId: string, createdAt: string): void {
+  const data = input.data === null ? null : JSON.stringify(input.data);
+  db.run(
+    `INSERT INTO sync_outbox (op_id, user_id, entity, record_id, op, data, sent, created_at)
+     VALUES (?, ?, ?, ?, ?, ?, 0, ?)`,
+    [opId, input.userId, input.entity, input.recordId, input.op, data, createdAt],
+  );
+}
+
+/**
+ * Adds one operation to the local log, applying the collapse rules.
+ * Call it inside the same transaction as the real table change.
+ *
+ * @returns ResponseParams, IsError true (400) for invalid input
+ */
+export function addOutboxOp(db: SqlDb, input: NewOutboxOp, options: OutboxOptions = {}): ResponseParams<null> {
+  const problem = validate(input);
+  if (problem !== null) {
+    return response(null, true, problem, 400);
+  }
+
+  try {
+    const newId = options.newId ?? (() => uuidv7());
+    const now = options.now ?? localNow;
+
+    // latest op of this record that the server has not seen yet
+    const pending = db.all<{ seq: number; op: OutboxOpType }>(
+      `SELECT seq, op FROM sync_outbox
+       WHERE entity = ? AND record_id = ? AND sent = 0
+       ORDER BY seq DESC LIMIT 1`,
+      [input.entity, input.recordId],
+    );
+
+    if (pending.length === 0) {
+      insertOp(db, input, newId(), now());
+      return response(null, false, "", 200);
+    }
+
+    const existing = pending[0];
+    const data = input.data === null ? null : JSON.stringify(input.data);
+
+    if (existing.op === "INSERT" && input.op === "UPDATE") {
+      // still a new row for the server, just with the latest data
+      db.run(`UPDATE sync_outbox SET data = ? WHERE seq = ?`, [data, existing.seq]);
+    } else if (existing.op === "INSERT" && input.op === "DELETE") {
+      // server never had it: nothing to send
+      db.run(`DELETE FROM sync_outbox WHERE seq = ?`, [existing.seq]);
+    } else if (existing.op === "UPDATE" && input.op === "UPDATE") {
+      db.run(`UPDATE sync_outbox SET data = ? WHERE seq = ?`, [data, existing.seq]);
+    } else if (existing.op === "UPDATE" && input.op === "DELETE") {
+      db.run(`UPDATE sync_outbox SET op = 'DELETE', data = NULL WHERE seq = ?`, [existing.seq]);
+    } else {
+      // no rule for this pair (e.g. after a DELETE): keep both, in order
+      insertOp(db, input, newId(), now());
+    }
+    return response(null, false, "", 200);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return response(null, true, "outbox write failed: " + message, 500);
+  }
+}
