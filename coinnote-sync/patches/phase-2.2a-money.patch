+/**
+ * Money helpers.
+ * The database stores amounts in whole paise (decision D4): 45050 = ₹450.50.
+ * Screens keep their own symbol / locale formatting and only convert the value:
+ *   CurrencyEnum[currency] + fromPaise(row.amount_paise).toLocaleString(locale)
+ */
+
+/**
+ * Rupees (number or text from an input field) -> whole paise.
+ * Rounds to the nearest paisa, so floating point noise (0.29 * 100 = 28.999...) is fixed.
+ *
+ * @returns paise, or null when the input is empty or not a number
+ */
+export function toPaise(value: number | string | null | undefined): number | null {
+  if (value === null || value === undefined) {
+    return null;
+  }
+
+  let rupees: number;
+  if (typeof value === "string") {
+    const text = value.trim();
+    if (text === "") {
+      return null;
+    }
+    rupees = Number(text);
+  } else {
+    rupees = value;
+  }
+
+  if (!Number.isFinite(rupees)) {
+    return null;
+  }
+  return Math.round(rupees * 100);
+}
+
+/**
+ * Whole paise -> rupees, for display and charts.
+ * null / undefined -> 0.
+ */
+export function fromPaise(paise: number | null | undefined): number {
+  if (paise === null || paise === undefined) {
+    return 0;
+  }
+  return paise / 100;
+}
